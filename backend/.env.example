# Environment
NODE_ENV=development
PORT=5000

# CORS
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRES_IN=30d

# Firebase/Firestore
# Recommended for deployments — the FULL service-account key JSON on a single line:
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}
# Local development — path to the downloaded service-account key file:
GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk.json
# Project ID for Firestore (defaults to examforge-201e8 if unset):
FIRESTORE_PROJECT_ID=examforge-201e8
# Alternative to the JSON blob — the individual service-account fields:
# FIREBASE_PROJECT_ID=examforge-201e8
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@examforge-201e8.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Supabase
SUPABASE_URL=https://fachmhcsfxjtgifexbyd.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# SignalR Hub
SIGNALR_HUB_URL=https://examforge-signalr.onrender.com/sessionHub

# Essay Grading API (DeepSeek)
ESSAY_GRADING_API_URL=https://examforge-signalr.onrender.com/api/essay/grade
DEEPSEEK_API_KEY=your_deepseek_api_key

# Publishing Server
PUBLISHING_SERVER_URL=https://examforge-publisher.onrender.com
