<Window x:Class="ExamForge.ConfigurationSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration Summary"
        Height="600"
        Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceDark}"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Exam Configuration Summary"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentGold}"/>
            <TextBlock Text="Review your configuration before proceeding to content creation"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Configuration Details -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Basic Information -->
                <Border Background="{StaticResource SurfaceLight}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Basic Information"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Exam Name:" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ExamName}" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <TextBlock Text="Subject Name:" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SubjectName}" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <TextBlock Text="Number of Items:" Grid.Row="2" Grid.Column="0" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding NumberOfItems}" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Exam Structure -->
                <Border Background="{StaticResource SurfaceLight}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Exam Structure"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="ExamStructureText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Timing Configuration -->
                <Border Background="{StaticResource SurfaceLight}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Timing Configuration"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="TimingText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Anti-Cheat Settings -->
                <Border Background="{StaticResource SurfaceLight}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Anti-Cheat Settings"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="AntiCheatText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Login Configuration -->
                <Border Background="{StaticResource SurfaceLight}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="Login Configuration"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="LoginConfigText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Go Back"
                    Width="120"
                    Height="40"
                    Background="{StaticResource SurfaceLight}"
                    Foreground="{StaticResource TextPrimary}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Margin="0,0,10,0"
                    Click="GoBack_Click"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Proceed"
                    Width="120"
                    Height="40"
                    Background="{StaticResource AccentGoldGradient}"
                    Foreground="{StaticResource SurfaceDark}"
                    BorderThickness="0"
                    Click="Proceed_Click"
                    Cursor="Hand"
                    FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>