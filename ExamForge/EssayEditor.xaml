<UserControl x:Class="ExamForge.EssayEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <StackPanel>
        <TextBlock Text="Essay Grading Infrastructure"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}"
                   Margin="0,0,0,8"/>
        <TextBlock Text="Define rubric, model answer, key points, and rubric weighting for AI-assisted essay grading."
                   FontSize="11"
                   Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <Border Background="{StaticResource SurfaceLight}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Rubric (required)"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="RubricTextBox"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimary}"
                         BorderThickness="0"
                         MinHeight="100"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="Rubric_TextChanged"/>
            </StackPanel>
        </Border>

        <Border Background="{StaticResource SurfaceLight}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Model answer (optional)"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="ModelAnswerTextBox"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimary}"
                         BorderThickness="0"
                         MinHeight="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="ModelAnswer_TextChanged"/>
            </StackPanel>
        </Border>

        <Border Background="{StaticResource SurfaceLight}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Key points checklist (optional)"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="KeyPointsTextBox"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimary}"
                         BorderThickness="0"
                         MinHeight="60"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="KeyPoints_TextChanged"/>
            </StackPanel>
        </Border>

        <Border Background="{StaticResource SurfaceLight}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Rubric weighting sliders"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Thesis" Grid.Column="0" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <Slider x:Name="ThesisWeightSlider" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="WeightSlider_ValueChanged"/>
                    <TextBlock x:Name="ThesisWeightText" Grid.Column="2" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Evidence" Grid.Column="0" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <Slider x:Name="EvidenceWeightSlider" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="WeightSlider_ValueChanged"/>
                    <TextBlock x:Name="EvidenceWeightText" Grid.Column="2" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Clarity" Grid.Column="0" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <Slider x:Name="ClarityWeightSlider" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="WeightSlider_ValueChanged"/>
                    <TextBlock x:Name="ClarityWeightText" Grid.Column="2" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Info Box -->
        <Border Background="{StaticResource SurfaceDark}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="ℹ️ Note:"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentGold}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Essay metadata is published with each essay question and used by the Essay Checker for AI-assisted grading."
                           FontSize="11"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Custom Points -->
        <Border Background="{StaticResource SurfaceLight}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Custom Points (optional)"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="CustomPointsTextBox"
                         Grid.Column="1"
                         Background="{StaticResource SurfaceDark}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderColor}"
                         BorderThickness="1"
                         Padding="8,6"
                         TextAlignment="Center"
                         TextChanged="CustomPoints_TextChanged">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>