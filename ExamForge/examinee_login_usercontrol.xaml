<UserControl x:Class="ExamForge.examinee_login_usercontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ExamForge"
             mc:Ignorable="d" 
             d:DesignHeight="524.04" d:DesignWidth="712"
             Margin="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="{StaticResource BackgroundDark}">
    <Grid Margin="0">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="24">
            <!-- Header -->
            <TextBlock Text="Examinee Login Options"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,24"/>

            <!-- Google Sign-In Radio Button -->
            <RadioButton x:Name="google_signin_radiobutton"
                         Content="Google Sign-In"
                         GroupName="LoginOptions"
                         Foreground="{StaticResource TextPrimary}"
                         FontSize="15"
                         FontWeight="Medium"
                         Margin="0,0,0,20"
                         Checked="GoogleSignIn_Checked">
                <RadioButton.ToolTip>
                    <ToolTip Background="{StaticResource SurfaceDark}" 
                             BorderBrush="{StaticResource BorderColor}">
                        <TextBlock Text="Examinees will log in using their Google accounts."
                                   Foreground="{StaticResource TextSecondary}"
                                   MaxWidth="300"
                                   TextWrapping="Wrap"/>
                    </ToolTip>
                </RadioButton.ToolTip>
            </RadioButton>

            <!-- Allow as Guests Radio Button -->
            <RadioButton x:Name="allow_guests_radiobutton"
                         Content="Allow as Guests"
                         GroupName="LoginOptions"
                         Foreground="{StaticResource TextPrimary}"
                         FontSize="15"
                         FontWeight="Medium"
                         Margin="0,0,0,16"
                         Checked="AllowGuests_Checked"
                         Unchecked="AllowGuests_Unchecked">
                <RadioButton.ToolTip>
                    <ToolTip Background="{StaticResource SurfaceDark}" 
                             BorderBrush="{StaticResource BorderColor}">
                        <TextBlock Text="Examinees can enter the exam by providing basic information without authentication."
                                   Foreground="{StaticResource TextSecondary}"
                                   MaxWidth="300"
                                   TextWrapping="Wrap"/>
                    </ToolTip>
                </RadioButton.ToolTip>
            </RadioButton>

            <!-- Sub-options for Allow as Guests (indented) -->
            <StackPanel Orientation="Vertical" Margin="32,0,0,0">
                <TextBlock Text="Required Information:"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="13"
                           Margin="0,0,0,12"/>

                <!-- Full Name -->
                <CheckBox x:Name="fullname_checkbox"
                          Content="Full Name"
                          Foreground="{StaticResource TextSecondary}"
                          FontSize="14"
                          Margin="0,0,0,12"
                          IsEnabled="False"
                          IsChecked="True">
                    <CheckBox.ToolTip>
                        <ToolTip Background="{StaticResource SurfaceDark}" 
                                 BorderBrush="{StaticResource BorderColor}">
                            <TextBlock Text="Require examinees to provide their full name."
                                       Foreground="{StaticResource TextSecondary}"
                                       MaxWidth="300"
                                       TextWrapping="Wrap"/>
                        </ToolTip>
                    </CheckBox.ToolTip>
                </CheckBox>

                <!-- Year and Section -->
                <CheckBox x:Name="year_section_checkbox"
                          Content="Year and Section"
                          Foreground="{StaticResource TextSecondary}"
                          FontSize="14"
                          Margin="0,0,0,12"
                          IsEnabled="False">
                    <CheckBox.ToolTip>
                        <ToolTip Background="{StaticResource SurfaceDark}" 
                                 BorderBrush="{StaticResource BorderColor}">
                            <TextBlock Text="Require examinees to provide their year level and section."
                                       Foreground="{StaticResource TextSecondary}"
                                       MaxWidth="300"
                                       TextWrapping="Wrap"/>
                        </ToolTip>
                    </CheckBox.ToolTip>
                </CheckBox>

                <!-- Student Number -->
                <CheckBox x:Name="student_number_checkbox"
                          Content="Student Number"
                          Foreground="{StaticResource TextSecondary}"
                          FontSize="14"
                          IsEnabled="False">
                    <CheckBox.ToolTip>
                        <ToolTip Background="{StaticResource SurfaceDark}" 
                                 BorderBrush="{StaticResource BorderColor}">
                            <TextBlock Text="Require examinees to provide their student ID number."
                                       Foreground="{StaticResource TextSecondary}"
                                       MaxWidth="300"
                                       TextWrapping="Wrap"/>
                        </ToolTip>
                    </CheckBox.ToolTip>
                </CheckBox>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
