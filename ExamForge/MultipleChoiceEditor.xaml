<UserControl x:Class="ExamForge.MultipleChoiceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <StackPanel>
        <TextBlock Text="Answer Options"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}"
                   Margin="0,0,0,12"/>

        <!-- Option A -->
        <Border Background="{StaticResource SurfaceLight}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="24" Height="24"
                        CornerRadius="999"
                        Background="{StaticResource SurfaceDark}"
                        Margin="0,0,12,0">
                    <TextBlock Text="A"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBox x:Name="OptionATextBox"
                         Grid.Column="1"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimary}"
                         BorderThickness="0"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         TextChanged="OptionTextBox_TextChanged"/>
                <RadioButton x:Name="CorrectA"
                             Grid.Column="2"
                             GroupName="CorrectAnswer"
                             VerticalAlignment="Center"
                             Checked="CorrectAnswer_Checked"/>
            </Grid>
        </Border>

        <!-- Option B -->
        <Border Background="{StaticResource SurfaceLight}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="24" Height="24"
                        CornerRadius="999"
                        Background="{StaticResource SurfaceDark}"
                        Margin="0,0,12,0">
                    <TextBlock Text="B"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBox x:Name="OptionBTextBox"
                         Grid.Column="1"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimary}"
                         BorderThickness="0"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         TextChanged="OptionTextBox_TextChanged"/>
                <RadioButton x:Name="CorrectB"
                             Grid.Column="2"
                             GroupName="CorrectAnswer"
                             VerticalAlignment="Center"
                             Checked="CorrectAnswer_Checked"/>
            </Grid>
        </Border>

        <!-- Option C -->
        <Border Background="{StaticResource SurfaceLight}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="24" Height="24"
                        CornerRadius="999"
                        Background="{StaticResource SurfaceDark}"
                        Margin="0,0,12,0">
                    <TextBlock Text="C"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBox x:Name="OptionCTextBox"
                         Grid.Column="1"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimary}"
                         BorderThickness="0"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         TextChanged="OptionTextBox_TextChanged"/>
                <RadioButton x:Name="CorrectC"
                             Grid.Column="2"
                             GroupName="CorrectAnswer"
                             VerticalAlignment="Center"
                             Checked="CorrectAnswer_Checked"/>
            </Grid>
        </Border>

        <!-- Option D -->
        <Border Background="{StaticResource SurfaceLight}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="24" Height="24"
                        CornerRadius="999"
                        Background="{StaticResource SurfaceDark}"
                        Margin="0,0,12,0">
                    <TextBlock Text="D"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBox x:Name="OptionDTextBox"
                         Grid.Column="1"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimary}"
                         BorderThickness="0"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         TextChanged="OptionTextBox_TextChanged"/>
                <RadioButton x:Name="CorrectD"
                             Grid.Column="2"
                             GroupName="CorrectAnswer"
                             VerticalAlignment="Center"
                             Checked="CorrectAnswer_Checked"/>
            </Grid>
        </Border>

        <!-- Custom Points Override -->
        <Border Background="{StaticResource SurfaceLight}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Custom Points (optional)"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="CustomPointsTextBox"
                         Grid.Column="1"
                         Background="{StaticResource SurfaceDark}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderColor}"
                         BorderThickness="1"
                         Padding="8,6"
                         TextAlignment="Center"
                         TextChanged="CustomPoints_TextChanged">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>