<Window x:Class="ExamForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:ExamForge"
        mc:Ignorable="d" 
        Title="ExamForge" 
        Height="800" 
        Width="1200"
        Background="{StaticResource BackgroundDark}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <local:sidebar_usercontrol x:Name="sidebar_usercontrol" 
                                  Grid.Column="0"
                                  Loaded="sidebar_usercontrol_Loaded"/>

        <!-- Main Content Host with Margin -->
        <ContentControl x:Name="MainContentHost" 
                       Grid.Column="1"
                       Margin="10,0,0,0"/>
    </Grid>
</Window>
