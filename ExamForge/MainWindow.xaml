<Window x:Class="ExamForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:ExamForge"
        mc:Ignorable="d" 
        Title="ExamForge" 
        Height="800" 
        Width="1200"
        Background="{StaticResource BackgroundDark}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <local:sidebar_usercontrol x:Name="sidebar_usercontrol" 
                                  Grid.Column="0"
                                  Loaded="sidebar_usercontrol_Loaded"/>

        <Grid Grid.Column="1" Margin="10,0,0,0">
            <ContentControl x:Name="MainContentHost"/>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,12,0"
                    Background="#E6F4F1"
                    CornerRadius="14"
                    Padding="10,6"
                    Panel.ZIndex="8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Signal:"
                               Foreground="#2e2f33"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SignalStrengthText"
                               Text="Checking..."
                               Foreground="#3aae9e"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="LoadingOverlay"
                    Visibility="Collapsed"
                    Background="#AAFFFFFF"
                    Panel.ZIndex="20">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="220" Height="8" IsIndeterminate="True" Foreground="#3aae9e"/>
                    <TextBlock x:Name="LoadingStatusText"
                               Text="Loading..."
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#2e2f33"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
