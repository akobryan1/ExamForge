<UserControl x:Class="ExamForge.dashboard_usercontrol_v2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource AppBackgroundBrush}"
             FontFamily="Segoe UI"
             Loaded="Dashboard_usercontrol_Loaded">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30" MaxWidth="1200">
            
            <!-- Page Title -->
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,30"/>

            <!-- KPI Row -->
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="UpcomingCard_Click">
                    <StackPanel>
                        <TextBlock Text="Upcoming Exams" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="UpcomingCountText" Style="{StaticResource KpiValueStyle}" Text="0"/>
                        <TextBlock x:Name="UpcomingSubtitle" Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,10,0" Cursor="Hand" MouseLeftButtonUp="LiveCard_Click">
                    <StackPanel>
                        <TextBlock Text="Live Now" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="LiveCountText" Style="{StaticResource KpiValueStyle}" Text="0"/>
                        <TextBlock x:Name="LiveSubtitle" Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="10,0,10,0" Cursor="Hand" MouseLeftButtonUp="GradingCard_Click">
                    <StackPanel>
                        <TextBlock Text="Pending Grading" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="GradingCountText" Style="{StaticResource KpiValueStyle}" Text="0"/>
                        <TextBlock x:Name="GradingSubtitle" Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="10,0,0,0" Cursor="Hand" MouseLeftButtonUp="FlagsCard_Click">
                    <StackPanel>
                        <TextBlock Text="Flags / Incidents" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="FlagsCountText" Style="{StaticResource KpiValueStyle}" Text="0"/>
                        <TextBlock x:Name="FlagsSubtitle" Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Content Grid -->
            <Grid Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Hero Panel (Live Monitor or Schedule) -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,15,0" MinHeight="250">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,15">
                            <TextBlock x:Name="HeroPanelTitle" Text="Live Exam Monitor" 
                                       Style="{StaticResource SectionTitleStyle}" DockPanel.Dock="Left"/>
                            <Button x:Name="HeroActionButton" Content="Open Monitor" Width="120" Height="34" 
                                    HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" 
                                    Click="HeroAction_Click"/>
                        </DockPanel>

                        <!-- Live Stats -->
                        <StackPanel x:Name="LiveStatsPanel" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Style="{StaticResource SmallTextStyle}">
                                <Run Text="Started: "/>
                                <Run x:Name="StartedCountRun" FontWeight="SemiBold" Text="0"/>
                                <Run Text=" | Submitted: "/>
                                <Run x:Name="SubmittedCountRun" FontWeight="SemiBold" Text="0"/>
                                <Run Text=" | Avg Progress: "/>
                                <Run x:Name="AvgProgressRun" FontWeight="SemiBold" Text="0%"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Schedule List -->
                        <ItemsControl x:Name="TodayScheduleList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource HeaderBackgroundBrush}" 
                                            CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                            <TextBlock Text="{Binding Schedule}" 
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Meta}" 
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TodayEmptyState" Text="No scheduled exams today." 
                                   Style="{StaticResource SmallTextStyle}" FontStyle="Italic" Visibility="Collapsed"/>
                        
                        <TextBlock x:Name="LiveEmpty" Text="✨ No exams running right now." 
                                   Style="{StaticResource SmallTextStyle}" FontStyle="Italic" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Right Column -->
                <StackPanel Grid.Column="1">
                    <!-- Grading Queue -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,15">
                                <TextBlock Text="Grading Queue" Style="{StaticResource SectionTitleStyle}" DockPanel.Dock="Left"/>
                                <Button Content="Open" Width="75" Height="30" HorizontalAlignment="Right" 
                                        Style="{StaticResource PrimaryButtonStyle}" Click="OpenGrading_Click"/>
                            </DockPanel>

                            <ItemsControl x:Name="GradingQueueList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding ExamTitle}" FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Student}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                            <Button Content="Grade" Width="75" Height="26" Margin="0,6,0,0"
                                                    Style="{StaticResource PrimaryButtonStyle}" Tag="{Binding Id}" 
                                                    Click="GradeQueueItem_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="GradingEmpty" Text="🎉 All caught up! No grading needed." 
                                       Style="{StaticResource SmallTextStyle}" FontStyle="Italic" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Performance Snapshot -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Performance Snapshot" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mean" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="MeanScoreText" Text="--" FontSize="22" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Pass Rate" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="PassRateText" Text="--" FontSize="22" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
