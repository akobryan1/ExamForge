<UserControl x:Class="ExamForge.timing_usercontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ExamForge"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="524.04" d:DesignWidth="712"
             Margin="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="{StaticResource BackgroundDark}">
    <Grid Margin="0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="24">
            <!-- Left Side: Exam Time Limit Section -->
            <StackPanel Orientation="Vertical" Margin="0,0,64,0">
                <TextBlock Text="Exam Time Limit"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal">
                    <!-- Hours -->
                    <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Hours" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   FontSize="13" 
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="hours_textbox"
                                 Width="80"
                                 Height="40"
                                 Padding="12,10"
                                 FontSize="14"
                                 Background="{StaticResource SurfaceDark}"
                                 Foreground="{StaticResource TextPrimary}"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource BorderColor}"
                                 BorderThickness="1"
                                 MaxLength="2"
                                 PreviewTextInput="NumericOnly_PreviewTextInput">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Minutes -->
                    <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Minutes" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   FontSize="13" 
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="minutes_textbox"
                                 Width="80"
                                 Height="40"
                                 Padding="12,10"
                                 FontSize="14"
                                 Background="{StaticResource SurfaceDark}"
                                 Foreground="{StaticResource TextPrimary}"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource BorderColor}"
                                 BorderThickness="1"
                                 MaxLength="2"
                                 PreviewTextInput="NumericOnly_PreviewTextInput">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Seconds -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Seconds" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   FontSize="13" 
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="seconds_textbox"
                                 Width="80"
                                 Height="40"
                                 Padding="12,10"
                                 FontSize="14"
                                 Background="{StaticResource SurfaceDark}"
                                 Foreground="{StaticResource TextPrimary}"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource BorderColor}"
                                 BorderThickness="1"
                                 MaxLength="2"
                                 PreviewTextInput="NumericOnly_PreviewTextInput">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Right Side: Live Exam Time Section -->
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Live Exam Time"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <!-- Start -->
                <StackPanel Orientation="Vertical" Margin="0,0,0,16">
                    <TextBlock Text="Start" 
                               Foreground="{StaticResource TextSecondary}" 
                               FontSize="13" 
                               Margin="0,0,0,8"/>
                    <xctk:DateTimePicker x:Name="start_datetime_picker"
                                         Width="220"
                                         Height="40"
                                         Background="{StaticResource SurfaceDark}"
                                         Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource BorderColor}"/>
                </StackPanel>

                <!-- End -->
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="End" 
                               Foreground="{StaticResource TextSecondary}" 
                               FontSize="13" 
                               Margin="0,0,0,8"/>
                    <xctk:DateTimePicker x:Name="end_datetime_picker"
                                         Width="220"
                                         Height="40"
                                         Background="{StaticResource SurfaceDark}"
                                         Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource BorderColor}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
