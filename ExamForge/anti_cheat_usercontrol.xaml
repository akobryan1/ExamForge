<UserControl x:Class="ExamForge.anti_cheat_usercontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ExamForge"
             mc:Ignorable="d" 
             d:DesignHeight="524.04" d:DesignWidth="712"
             Margin="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="{StaticResource BackgroundDark}">
    <Grid Margin="0">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="24">
            <!-- Detect Tabbing Checkbox -->
            <CheckBox x:Name="detect_tabbing_checkbox"
                      Content="Detect Tabbing"
                      Foreground="{StaticResource TextPrimary}"
                      FontSize="15"
                      FontWeight="Medium"
                      Margin="0,0,0,16"
                      Checked="DetectTabbing_CheckedChanged"
                      Unchecked="DetectTabbing_CheckedChanged">
                <CheckBox.ToolTip>
                    <ToolTip Background="{StaticResource SurfaceDark}" 
                             BorderBrush="{StaticResource BorderColor}">
                        <TextBlock Text="When the examinee selects a tab or minimizes the page, the exam detects it."
                                   Foreground="{StaticResource TextSecondary}"
                                   MaxWidth="300"
                                   TextWrapping="Wrap"/>
                    </ToolTip>
                </CheckBox.ToolTip>
            </CheckBox>

            <!-- Sub-options (indented) -->
            <StackPanel Orientation="Vertical" Margin="32,0,0,24">
                <!-- Warning Only -->
                <CheckBox x:Name="warning_only_checkbox"
                          Content="Warning Only"
                          Foreground="{StaticResource TextSecondary}"
                          FontSize="14"
                          Margin="0,0,0,12"
                          IsEnabled="False"/>

                <!-- Deduct Points -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox x:Name="deduct_points_checkbox"
                              Content="Deduct Points"
                              Foreground="{StaticResource TextSecondary}"
                              FontSize="14"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              IsEnabled="False"
                              Checked="DeductPoints_CheckedChanged"
                              Unchecked="DeductPoints_CheckedChanged"/>
                    <TextBox x:Name="deduct_points_textbox"
                             Width="80"
                             Height="36"
                             Padding="12,8"
                             FontSize="14"
                             Background="{StaticResource SurfaceDark}"
                             Foreground="{StaticResource TextPrimary}"
                             VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource BorderColor}"
                             BorderThickness="1"
                             MaxLength="3"
                             Text="0"
                             IsEnabled="False"
                             PreviewTextInput="NumericOnly_PreviewTextInput">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Text="points"
                               Foreground="{StaticResource TextTertiary}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Auto-Submit -->
                <CheckBox x:Name="auto_submit_checkbox"
                          Content="Auto-Submit"
                          Foreground="{StaticResource TextSecondary}"
                          FontSize="14"
                          IsEnabled="False"/>
            </StackPanel>

            <!-- One Question at a Time Checkbox -->
            <CheckBox x:Name="one_question_at_a_time_checkbox"
                      Content="One Question at a Time"
                      Foreground="{StaticResource TextPrimary}"
                      FontSize="15"
                      FontWeight="Medium"
                      Margin="0,0,0,16"
                      Checked="OneQuestionAtATime_CheckedChanged"
                      Unchecked="OneQuestionAtATime_CheckedChanged">
                <CheckBox.ToolTip>
                    <ToolTip Background="{StaticResource SurfaceDark}" 
                             BorderBrush="{StaticResource BorderColor}">
                        <TextBlock Text="The exam page will only display one question at a time with navigation buttons."
                                   Foreground="{StaticResource TextSecondary}"
                                   MaxWidth="300"
                                   TextWrapping="Wrap"/>
                    </ToolTip>
                </CheckBox.ToolTip>
            </CheckBox>

            <!-- Sub-options for One Question at a Time (indented) -->
            <StackPanel Orientation="Vertical" Margin="32,0,0,24">
                <!-- Disable Backtrack -->
                <CheckBox x:Name="disable_backtrack_checkbox"
                          Content="Disable Backtrack"
                          Foreground="{StaticResource TextSecondary}"
                          FontSize="14"
                          Margin="0,0,0,12"
                          IsEnabled="False">
                    <CheckBox.ToolTip>
                        <ToolTip Background="{StaticResource SurfaceDark}" 
                                 BorderBrush="{StaticResource BorderColor}">
                            <TextBlock Text="Prevents examinees from going back to previous questions."
                                       Foreground="{StaticResource TextSecondary}"
                                       MaxWidth="300"
                                       TextWrapping="Wrap"/>
                        </ToolTip>
                    </CheckBox.ToolTip>
                </CheckBox>

                <!-- Time Limit Per Question -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <CheckBox x:Name="time_limit_per_question_checkbox"
                              Content="Time limit per question"
                              Foreground="{StaticResource TextSecondary}"
                              FontSize="14"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              IsEnabled="False"
                              Checked="TimeLimitPerQuestion_CheckedChanged"
                              Unchecked="TimeLimitPerQuestion_CheckedChanged">
                        <CheckBox.ToolTip>
                            <ToolTip Background="{StaticResource SurfaceDark}" 
                                     BorderBrush="{StaticResource BorderColor}">
                                <TextBlock Text="Sets a time limit for each individual question. Questions auto-advance when time expires."
                                           Foreground="{StaticResource TextSecondary}"
                                           MaxWidth="300"
                                           TextWrapping="Wrap"/>
                            </ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>
                    <TextBox x:Name="time_limit_textbox"
                             Width="80"
                             Height="36"
                             Padding="12,8"
                             FontSize="14"
                             Background="{StaticResource SurfaceDark}"
                             Foreground="{StaticResource TextPrimary}"
                             VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource BorderColor}"
                             BorderThickness="1"
                             MaxLength="4"
                             Text="60"
                             IsEnabled="False"
                             PreviewTextInput="NumericOnly_PreviewTextInput">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Text="seconds"
                               Foreground="{StaticResource TextTertiary}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Disable Copy + Pasting Checkbox -->
            <CheckBox x:Name="disable_copy_paste_checkbox"
                      Content="Disable Copy + Pasting"
                      Foreground="{StaticResource TextPrimary}"
                      FontSize="15"
                      FontWeight="Medium"
                      Margin="0,0,0,16">
                <CheckBox.ToolTip>
                    <ToolTip Background="{StaticResource SurfaceDark}" 
                             BorderBrush="{StaticResource BorderColor}">
                        <TextBlock Text="Prevents examinees from copying or pasting text during the exam."
                                   Foreground="{StaticResource TextSecondary}"
                                   MaxWidth="300"
                                   TextWrapping="Wrap"/>
                    </ToolTip>
                </CheckBox.ToolTip>
            </CheckBox>

            <!-- Disable Screenshot/PrintScreen Checkbox -->
            <CheckBox x:Name="disable_screenshot_checkbox"
                      Content="Disable Screenshot or PrintScreen"
                      Foreground="{StaticResource TextPrimary}"
                      FontSize="15"
                      FontWeight="Medium"
                      Margin="0,0,0,16">
                <CheckBox.ToolTip>
                    <ToolTip Background="{StaticResource SurfaceDark}" 
                             BorderBrush="{StaticResource BorderColor}">
                        <TextBlock Text="Blocks screenshot functionality and PrintScreen key during the exam."
                                   Foreground="{StaticResource TextSecondary}"
                                   MaxWidth="300"
                                   TextWrapping="Wrap"/>
                    </ToolTip>
                </CheckBox.ToolTip>
            </CheckBox>

            <!-- Auto-Resume Session Checkbox -->
            <CheckBox x:Name="auto_resume_session_checkbox"
                      Content="Auto-Resume Session"
                      Foreground="{StaticResource TextPrimary}"
                      FontSize="15"
                      FontWeight="Medium"
                      Margin="0,0,0,16">
                <CheckBox.ToolTip>
                    <ToolTip Background="{StaticResource SurfaceDark}" 
                             BorderBrush="{StaticResource BorderColor}">
                        <TextBlock Text="Allows examinees to resume their exam if disconnected. Progress is automatically saved to prevent data loss."
                                   Foreground="{StaticResource TextSecondary}"
                                   MaxWidth="300"
                                   TextWrapping="Wrap"/>
                    </ToolTip>
                </CheckBox.ToolTip>
            </CheckBox>
        </StackPanel>
    </Grid>
</UserControl>
