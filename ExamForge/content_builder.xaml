<UserControl x:Class="ExamForge.content_builder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="1200"
             Margin="0"
             Background="{StaticResource BackgroundDark}">
    <UserControl.Resources>
        <!-- Filter Button Style -->
        <Style x:Key="FilterChipStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                CornerRadius="999"
                                Padding="{TemplateBinding Padding}"
                                Background="{StaticResource SurfaceLight}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2b3445"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#6AA6FF" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="#6AA6FF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: Items Navigator -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceDark}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Items Navigator"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Groups: "
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="GroupsCount"
                                   Text="0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search Box -->
                <TextBox x:Name="SearchBox"
                         Grid.Row="1"
                         Margin="0,0,0,12"
                         Padding="10,8"
                         Background="{StaticResource SurfaceLight}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderColor}"
                         BorderThickness="1"
                         FontSize="13"
                         TextChanged="SearchBox_TextChanged">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Filters -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                    <ToggleButton x:Name="AllFilter"
                                  Content="All"
                                  IsChecked="True"
                                  Style="{StaticResource FilterChipStyle}"
                                  Margin="0,0,6,0"
                                  Click="FilterButton_Click"/>
                    <ToggleButton x:Name="IncompleteFilter"
                                  Content="Incomplete"
                                  Style="{StaticResource FilterChipStyle}"
                                  Margin="0,0,6,0"
                                  Click="FilterButton_Click"/>
                    <ToggleButton x:Name="CompleteFilter"
                                  Content="Complete"
                                  Style="{StaticResource FilterChipStyle}"
                                  Margin="0,0,6,0"
                                  Click="FilterButton_Click"/>
                    <ToggleButton x:Name="ReviewFilter"
                                  Content="Review"
                                  Style="{StaticResource FilterChipStyle}"
                                  Click="FilterButton_Click"/>
                </StackPanel>

                <!-- Items List -->
                <ListBox x:Name="ItemsListBox"
                         Grid.Row="3"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="ItemsListBox_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border"
                                                Margin="0,0,0,8"
                                                Padding="12"
                                                CornerRadius="10"
                                                Background="{StaticResource SurfaceLight}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Number Badge -->
                                                <Border Grid.Column="0"
                                                        Width="28" Height="28"
                                                        CornerRadius="999"
                                                        Background="{StaticResource SurfaceDark}"
                                                        BorderBrush="{StaticResource BorderColor}"
                                                        BorderThickness="1"
                                                        Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Number}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Item Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   Margin="0,0,8,0"/>
                                                        <Border Padding="6,2"
                                                                CornerRadius="999"
                                                                Background="{StaticResource SurfaceDark}">
                                                            <TextBlock Text="{Binding TestGroup}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource TextSecondary}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding TestType}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                </StackPanel>

                                                <!-- Status Indicator -->
                                                <Ellipse Grid.Column="2"
                                                         Width="10" Height="10"
                                                         Fill="{Binding StatusColor}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="#6AA6FF" Opacity="0.15"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#6AA6FF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#2b3445"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- RIGHT PANEL: Item Editor -->
        <Grid Grid.Column="1" Background="{StaticResource BackgroundDark}">
            <!-- Empty State -->
            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="Select an item to edit"
                           FontSize="16"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Select an item from the navigator to begin editing."
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Editor Panel -->
            <Grid x:Name="EditorPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Editor Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceDark}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="0,0,0,1"
                        Padding="24,16">
                    <StackPanel>
                        <TextBlock x:Name="ItemNumberLabel"
                                   Text="Item 1"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border x:Name="TestGroupBadge"
                                    Padding="10,4"
                                    CornerRadius="999"
                                    Background="{StaticResource SurfaceLight}"
                                    Margin="0,0,8,0">
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </Border>
                            <Border x:Name="TestTypeBadge"
                                    Padding="10,4"
                                    CornerRadius="999"
                                    Background="{StaticResource SurfaceLight}"
                                    Margin="0,0,8,0">
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </Border>
                            <Border x:Name="PointsBadge"
                                    Padding="10,4"
                                    CornerRadius="999"
                                    Background="{StaticResource AccentGoldGradient}">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SurfaceDark}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Editor Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Padding="24">
                        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                            <!-- Question Input -->
                            <TextBlock Text="Question"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="QuestionTextBox"
                                     MinHeight="100"
                                     Padding="12"
                                     Background="{StaticResource SurfaceLight}"
                                     Foreground="{StaticResource TextPrimary}"
                                     BorderBrush="{StaticResource BorderColor}"
                                     BorderThickness="1"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="14"
                                     TextChanged="QuestionTextBox_TextChanged">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Answer Editor Host -->
                            <ContentControl x:Name="AnswerEditorHost" Margin="0,24,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Bottom Actions -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceDark}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="0,1,0,0"
                        Padding="24,16">
                    <Grid>
                        <Button Content="Next Item"
                                Width="120"
                                Height="40"
                                HorizontalAlignment="Left"
                                Background="{StaticResource SurfaceLight}"
                                Foreground="{StaticResource TextPrimary}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="NextItem_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <StackPanel Grid.Row="4" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Right" 
                                    Margin="0,20,0,0">
                            
                            <!-- Previous Button -->
                            <Button x:Name="PreviousButton"
                                    Content="← Previous"
                                    Click="Previous_Click"
                                    Background="{StaticResource SurfaceLight}"
                                    Foreground="{StaticResource TextPrimary}"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    Padding="20,12"
                                    Margin="0,0,12,0"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Height="44"
                                    MinWidth="120">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            
                            <!-- Preview Button -->
                            <Button x:Name="PreviewButton"
                                    Content="Preview →"
                                    Click="Preview_Click"
                                    Background="{StaticResource AccentGoldGradient}"
                                    Foreground="{StaticResource SurfaceDark}"
                                    BorderThickness="0"
                                    Padding="20,12"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Height="44"
                                    MinWidth="120">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
