<UserControl x:Class="ExamForge.sidebar_usercontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="240"
             Margin="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <!-- Clean Sidebar Button Style -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="8"
                                Padding="12,0"
                                Background="Transparent">
                            <ContentPresenter Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                          To="#F8FAFB"
                                                          Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                          To="Transparent"
                                                          Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HeaderBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="0" 
            Margin="0"
            Background="{StaticResource SidebarBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrushLight}"
            BorderThickness="0,0,1,0">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,24,16,32">
                <Border Width="40" Height="40" 
                        CornerRadius="8"
                        Background="{StaticResource PrimaryBrush}">
                    <Image x:Name="ExamForge_Icon"
                           Width="24" Height="24"
                           Source="pack://application:,,,/ICONS/white_anvil64.png"/>
                </Border>
                <TextBlock Text="ExamForge"
                           Margin="12,0,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Nav buttons -->
            <StackPanel Grid.Row="1" Margin="12,0,12,0">
                <!-- Dashboard -->
                <Button x:Name="dashboard_button"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="Button_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/ICONS/dashboard_grey32.png"
                               Width="20" Height="20" Stretch="Uniform"/>
                        <TextBlock Text="Dashboard" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Create -->
                <Button x:Name="create_button"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="Create_Button_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/ICONS/foundry_grey32.png"
                               Width="20" Height="20" Stretch="Uniform"/>
                        <TextBlock Text="Create" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Analytics -->
                <Button x:Name="analytics_button"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="Analytics_Button_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/ICONS/analytics_grey32.png"
                               Width="20" Height="20" Stretch="Uniform"/>
                        <TextBlock Text="Analytics" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Published Exams -->
                <Button x:Name="published_exams_button"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="Published_Exams_Button_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/ICONS/exam_grey32.png"
                               Width="20" Height="20" Stretch="Uniform"/>
                        <TextBlock Text="Published Exams" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Spacer -->
            <Border Grid.Row="2"/>

            <!-- User Info & Settings -->
            <StackPanel Grid.Row="3" Margin="12,0,12,8">
                <!-- Username Greeting -->
                <TextBlock x:Name="UsernameGreeting"
                           Text="Hello, User"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="12,0,0,12"
                           TextTrimming="CharacterEllipsis"/>
                
                <Button x:Name="settings_button"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="Settings_Button_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/ICONS/setting_grey32.png"
                               Width="20" Height="20" Stretch="Uniform"/>
                        <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Logout -->
            <StackPanel Grid.Row="4" Margin="12,0,12,16">
                <Button x:Name="logout_button"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="logout_button_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/ICONS/logout_grey32.png"
                               Width="20" Height="20" Stretch="Uniform"/>
                        <TextBlock Text="Logout" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
