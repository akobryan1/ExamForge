<UserControl x:Class="ExamForge.student_analytics_usercontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1000"
             Margin="0"
             Background="{StaticResource AppBackgroundBrush}">

    <UserControl.Resources>
        <!-- Tab Button Style -->
        <Style x:Key="AnalyticsTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Analytics Card Style -->
        <Style x:Key="AnalyticsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Metric Card Style -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <!-- Rounded Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="6" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Light Modern Background -->
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" 
                Padding="30,24,30,16">
            <StackPanel>
                <TextBlock Text="Student Analytics and Performance Insights"
                           Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Analyze student performance, identify learning gaps, and track progress over time"
                           Style="{StaticResource SmallTextStyle}"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tab Navigation -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="0,0,0,1"
                Padding="30,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ClassOverviewTab"
                             Content="?? Class Overview"
                             Style="{StaticResource AnalyticsTabButtonStyle}"
                             IsChecked="True"
                             Checked="AnalyticsTab_Changed"/>
                <RadioButton x:Name="ItemAnalysisTab"
                             Content="?? Item Analysis"
                             Style="{StaticResource AnalyticsTabButtonStyle}"
                             Checked="AnalyticsTab_Changed"/>
                <RadioButton x:Name="StudentDrilldownTab"
                             Content="?? Student Drilldown"
                             Style="{StaticResource AnalyticsTabButtonStyle}"
                             Checked="AnalyticsTab_Changed"/>
                <RadioButton x:Name="IntegrityTab"
                             Content="?? Integrity and Incidents"
                             Style="{StaticResource AnalyticsTabButtonStyle}"
                             Checked="AnalyticsTab_Changed"/>
                <RadioButton x:Name="TrendsTab"
                             Content="?? Trends Over Time"
                             Style="{StaticResource AnalyticsTabButtonStyle}"
                             Checked="AnalyticsTab_Changed"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,16,24,24">
            <Grid>
                <!-- Class Overview Panel -->
                <StackPanel x:Name="ClassOverviewPanel" Visibility="Visible">
                    <!-- Filter Bar -->
                    <Border Style="{StaticResource AnalyticsCardStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Analytics Filters" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            
                            <ComboBox x:Name="SchoolYearFilter" Grid.Column="1" Width="120" Margin="12,0,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="2023-2024"/>
                                <ComboBoxItem Content="2022-2023"/>
                            </ComboBox>
                            
                            <ComboBox x:Name="SubjectAnalyticsFilter" Grid.Column="2" Width="120" Margin="8,0,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="All Subjects"/>
                                <ComboBoxItem Content="Mathematics"/>
                                <ComboBoxItem Content="Science"/>
                                <ComboBoxItem Content="History"/>
                            </ComboBox>
                            
                            <ComboBox x:Name="ExamAnalyticsFilter" Grid.Column="3" Width="150" Margin="8,0,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="All Exams"/>
                                <ComboBoxItem Content="Midterm Exam"/>
                                <ComboBoxItem Content="Final Exam"/>
                            </ComboBox>
                            
                            <Button Grid.Column="4" Content="Apply Filters" Margin="12,0,0,0" 
                                    Style="{StaticResource PrimaryButtonStyle}" Click="ApplyFilters_Click"/>
                        </Grid>
                    </Border>

                    <!-- Quick Metrics Row -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="78.5%" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Class Average" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="? 3.2% from last exam" FontSize="10" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="82%" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Pass Rate" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="24 of 29 students" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="96%" FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Completion Rate" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="28 of 29 submitted" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}" Margin="8,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="3.2%" FontSize="32" FontWeight="Bold" Foreground="{StaticResource WarningYellow}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Flagged Rate" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="5 integrity incidents" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Main Analytics Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Score Distribution -->
                        <Border Grid.Column="0" Style="{StaticResource AnalyticsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="?? Score Distribution" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>
                                
                                <!-- Score Histogram -->
                                <Canvas Name="ScoreHistogram" Height="200" Background="{StaticResource HeaderBackgroundBrush}" Margin="0,0,0,16"/>
                                
                                <!-- Statistics -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Mean: 78.5%" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Median: 81.0%" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Std Dev: 12.3" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Range: 45-98%" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Q1: 68%" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Q3: 87%" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Item Analysis Panel -->
                <StackPanel x:Name="ItemAnalysisPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource AnalyticsCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="?? Exam Item Analysis" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <Button Content="Export Analysis" Margin="16,0,0,0" Padding="12,6" Background="{StaticResource AccentBlue}" Foreground="White" BorderThickness="0" Style="{StaticResource RoundedButtonStyle}" Click="ExportItemAnalysis_Click"/>
                            </StackPanel>

                            <!-- Item Analysis Grid -->
                            <DataGrid x:Name="ItemAnalysisGrid" 
                                     Background="Transparent"
                                     GridLinesVisibility="None"
                                     HeadersVisibility="Column"
                                     AutoGenerateColumns="False"
                                     CanUserAddRows="False"
                                     CanUserDeleteRows="False"
                                     IsReadOnly="True"
                                     SelectionMode="Single"
                                     Height="500">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Question #" Binding="{Binding QuestionNumber}" Width="80"/>
                                    <DataGridTextColumn Header="Question Type" Binding="{Binding QuestionType}" Width="100"/>
                                    <DataGridTextColumn Header="Difficulty %" Binding="{Binding DifficultyPercent}" Width="90"/>
                                    <DataGridTextColumn Header="Discrimination" Binding="{Binding Discrimination}" Width="100"/>
                                    <DataGridTextColumn Header="Point Biserial" Binding="{Binding PointBiserial}" Width="100"/>
                                    <DataGridTextColumn Header="No Response %" Binding="{Binding NoResponsePercent}" Width="100"/>
                                    <DataGridTextColumn Header="Avg Time (sec)" Binding="{Binding AverageTime}" Width="100"/>
                                    <DataGridTextColumn Header="Quality" Binding="{Binding QualityIndicator}" Width="80"/>
                                    <DataGridTemplateColumn Header="Actions" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Details" FontSize="10" Padding="6,3" Click="ItemDetails_Click" Tag="{Binding QuestionId}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Student Drilldown Panel -->
                <StackPanel x:Name="StudentDrilldownPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Student List -->
                        <Border Grid.Column="0" Style="{StaticResource AnalyticsCardStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="?? Select Student" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                                
                                <TextBox x:Name="StudentSearchBox" Text="Search students..." Padding="8" Background="{StaticResource SurfaceLight}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" FontSize="12" Margin="0,0,0,12" GotFocus="StudentSearchBox_GotFocus" LostFocus="StudentSearchBox_LostFocus"/>
                                
                                <ListBox x:Name="StudentListBox" Height="400" Background="{StaticResource SurfaceLight}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" SelectionChanged="StudentListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="{Binding ScoreText}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Student Details -->
                        <Border Grid.Column="1" Style="{StaticResource AnalyticsCardStyle}">
                            <StackPanel x:Name="StudentDetailsPanel">
                                <DockPanel Margin="0,0,0,16">
                                    <TextBlock x:Name="SelectedStudentName" Text="Select a student to view details" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left"/>
                                    <Button Content="?? View Full Submission" Width="180" Height="35" HorizontalAlignment="Right"
                                            Style="{StaticResource PrimaryButtonStyle}" Click="ViewSubmission_Click"
                                            x:Name="ViewSubmissionButton" Visibility="Collapsed"/>
                                </DockPanel>
                                
                                <!-- Student performance details will be populated here -->
                                <Grid x:Name="StudentPerformanceGrid" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Performance Summary -->
                                    <Grid Grid.Row="0" Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock x:Name="StudentScore" Text="85%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Total Score" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock x:Name="StudentRank" Text="7th" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Class Rank" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock x:Name="StudentTime" Text="45:32" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Time Taken" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}" Margin="8,0,0,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock x:Name="StudentFlags" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Flags" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Mastery Breakdown -->
                                    <Border Grid.Row="1" Background="{StaticResource SurfaceLight}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="?? Mastery Breakdown" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                                            <Grid x:Name="MasteryGrid">
                                                <!-- Mastery data will be populated dynamically -->
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Missed Items -->
                                    <Border Grid.Row="2" Background="{StaticResource SurfaceLight}" CornerRadius="8" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="? Missed Items" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                                            <DataGrid x:Name="MissedItemsGrid" 
                                                     Background="Transparent"
                                                     GridLinesVisibility="None"
                                                     HeadersVisibility="Column"
                                                     AutoGenerateColumns="False"
                                                     CanUserAddRows="False"
                                                     CanUserDeleteRows="False"
                                                     IsReadOnly="True"
                                                     SelectionMode="Single"
                                                     Height="200">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Q#" Binding="{Binding QuestionNumber}" Width="40"/>
                                                    <DataGridTextColumn Header="Topic" Binding="{Binding Topic}" Width="120"/>
                                                    <DataGridTextColumn Header="Student Answer" Binding="{Binding StudentAnswer}" Width="120"/>
                                                    <DataGridTextColumn Header="Correct Answer" Binding="{Binding CorrectAnswer}" Width="120"/>
                                                    <DataGridTextColumn Header="Points Lost" Binding="{Binding PointsLost}" Width="80"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Integrity & Incidents Panel -->
                <StackPanel x:Name="IntegrityPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Integrity Summary -->
                        <Border Grid.Row="0" Style="{StaticResource AnalyticsCardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="12" FontSize="32" FontWeight="Bold" Foreground="{StaticResource WarningYellow}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Total Incidents" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="7" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tab Switches" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="3" FontSize="32" FontWeight="Bold" Foreground="{StaticResource ErrorRed}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Focus Loss" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}" Margin="8,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="2" FontSize="32" FontWeight="Bold" Foreground="{StaticResource ErrorRed}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Multiple Logins" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Incident Timeline -->
                        <Border Grid.Row="1" Style="{StaticResource AnalyticsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="??? Integrity Incident Timeline" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Button Content="Export Report" Margin="16,0,0,0" Padding="12,6" Background="{StaticResource ErrorRed}" Foreground="White" BorderThickness="0" Style="{StaticResource RoundedButtonStyle}" Click="ExportIntegrityTimeline_Click"/>
                                </StackPanel>

                                <DataGrid x:Name="IntegrityIncidentsGrid" 
                                         Background="Transparent"
                                         GridLinesVisibility="None"
                                         HeadersVisibility="Column"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         CanUserDeleteRows="False"
                                         IsReadOnly="True"
                                         SelectionMode="Single"
                                         Height="400">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="80"/>
                                        <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="150"/>
                                        <DataGridTextColumn Header="Event Type" Binding="{Binding EventType}" Width="120"/>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                                        <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="120"/>
                                        <DataGridTemplateColumn Header="Action" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Review" FontSize="10" Padding="6,3" Click="ReviewIncident_Click" Tag="{Binding Id}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Trends Over Time Panel -->
                <StackPanel x:Name="TrendsPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Trend Controls -->
                        <Border Grid.Row="0" Style="{StaticResource AnalyticsCardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="?? Performance Trends" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                
                                <ComboBox x:Name="TrendPeriodFilter" Grid.Column="1" Width="120" Margin="12,0,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Last 6 months"/>
                                    <ComboBoxItem Content="This semester"/>
                                    <ComboBoxItem Content="This year"/>
                                </ComboBox>
                                
                                <ComboBox x:Name="TrendMetricFilter" Grid.Column="2" Width="150" Margin="8,0,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Class Average"/>
                                    <ComboBoxItem Content="Pass Rate"/>
                                    <ComboBoxItem Content="Completion Rate"/>
                                </ComboBox>
                                
                                <Button Grid.Column="3" Content="Update Chart" Margin="12,0,0,0" Padding="12,6" Background="{StaticResource AccentGold}" Foreground="{StaticResource BackgroundDark}" BorderThickness="0" Style="{StaticResource RoundedButtonStyle}" Click="UpdateTrendChart_Click"/>
                            </Grid>
                        </Border>

                        <!-- Trend Charts -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Main Trend Chart -->
                            <Border Grid.Column="0" Style="{StaticResource AnalyticsCardStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Class Performance Trends" FontSize="16" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                                    <Canvas x:Name="TrendChart" Height="300" Background="{StaticResource SurfaceLight}"/>
                                </StackPanel>
                            </Border>

                            <!-- Trend Insights -->
                            <Border Grid.Column="1" Style="{StaticResource AnalyticsCardStyle}">
                                <StackPanel x:Name="TrendInsightsPanel">
                                    <!-- Trend insights content will be populated dynamically -->
                                    <TextBlock Text="?? Trend Insights" FontSize="16" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                                    <TextBlock Text="Loading trend insights..." FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
