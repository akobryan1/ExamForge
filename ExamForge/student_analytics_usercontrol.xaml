<UserControl x:Class="ExamForge.student_analytics_usercontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1000"
             Margin="0"
             Background="{StaticResource AppBackgroundBrush}">

    <UserControl.Resources>
        <!-- Tab Button Style -->
        <Style x:Key="AnalyticsTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Analytics Card Style -->
        <Style x:Key="AnalyticsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Metric Card Style -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <!-- Rounded Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="6" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Light Modern Background -->
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" 
                Padding="30,24,30,16">
            <StackPanel>
                <TextBlock Text="Student Analytics and Performance Insights"
                           Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Analyze student performance, identify learning gaps, and track progress over time"
                           Style="{StaticResource SmallTextStyle}"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tab Navigation -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="0,0,0,1"
                Padding="30,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ClassOverviewTab"
                             Content="?? Class Performance"
                             Style="{StaticResource AnalyticsTabButtonStyle}"
                             IsChecked="True"
                             Checked="AnalyticsTab_Changed"/>
                <RadioButton x:Name="ItemAnalysisTab"
                             Content="?? Item Analysis"
                             Style="{StaticResource AnalyticsTabButtonStyle}"
                             Checked="AnalyticsTab_Changed"/>
                <RadioButton x:Name="IntegrityTab"
                             Content="?? Incident Reports"
                             Style="{StaticResource AnalyticsTabButtonStyle}"
                             Checked="AnalyticsTab_Changed"/>
                <RadioButton x:Name="ExamineeDataTab"
                             Content="?? Examinee Data"
                             Style="{StaticResource AnalyticsTabButtonStyle}"
                             Checked="AnalyticsTab_Changed"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,16,24,24">
            <Grid>
                <!-- Class Overview Panel -->
                <StackPanel x:Name="ClassOverviewPanel" Visibility="Visible">
                    <!-- Filter Bar -->
                    <Border Style="{StaticResource AnalyticsCardStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Analytics Filters" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            
                            <ComboBox x:Name="SchoolYearFilter" Grid.Column="1" Width="120" Margin="12,0,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="2023-2024"/>
                                <ComboBoxItem Content="2022-2023"/>
                            </ComboBox>
                            
                            <ComboBox x:Name="SubjectAnalyticsFilter" Grid.Column="2" Width="120" Margin="8,0,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="All Subjects"/>
                                <ComboBoxItem Content="Mathematics"/>
                                <ComboBoxItem Content="Science"/>
                                <ComboBoxItem Content="History"/>
                            </ComboBox>
                            
                            <ComboBox x:Name="ExamAnalyticsFilter" Grid.Column="3" Width="150" Margin="8,0,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="All Exams"/>
                                <ComboBoxItem Content="Midterm Exam"/>
                                <ComboBoxItem Content="Final Exam"/>
                            </ComboBox>
                            
                            <Button Grid.Column="4" Content="Apply Filters" Margin="12,0,0,0" 
                                    Style="{StaticResource PrimaryButtonStyle}" Click="ApplyFilters_Click"/>
                        </Grid>
                    </Border>

                    <!-- Quick Metrics Row -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="ClassAverageMetricText" Text="0.0%" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Class Average" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="? 3.2% from last exam" FontSize="10" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="PassRateMetricText" Text="0%" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Pass Rate" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="24 of 29 students" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="CompletionRateMetricText" Text="0%" FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Completion Rate" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="28 of 29 submitted" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}" Margin="8,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="FlaggedRateMetricText" Text="0.0%" FontSize="32" FontWeight="Bold" Foreground="{StaticResource WarningYellow}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Flagged Rate" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="5 integrity incidents" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Main Analytics Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Score Distribution -->
                        <Border Grid.Column="0" Style="{StaticResource AnalyticsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="?? Score Distribution" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>
                                
                                <!-- Score Histogram -->
                                <Canvas Name="ScoreHistogram" Height="200" Background="{StaticResource HeaderBackgroundBrush}" Margin="0,0,0,16"/>
                                
                                <!-- Statistics -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Mean: 78.5%" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Median: 81.0%" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Std Dev: 12.3" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Range: 45-98%" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Q1: 68%" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Q3: 87%" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Item Analysis Panel -->
                <StackPanel x:Name="ItemAnalysisPanel" Visibility="Collapsed">
                    <!-- Item Analysis Header -->
                    <Border Style="{StaticResource AnalyticsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="?? Item Analysis Report" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button Content="?? Export Report" Margin="16,0,0,0" Padding="12,6" Style="{StaticResource PrimaryButtonStyle}" Click="ExportItemAnalysis_Click"/>
                            </StackPanel>
                            
                            <!-- Item Analysis Summary Cards -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="EasyItemsCount" Text="0" FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Easy Items" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="?70% correct" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="ModerateItemsCount" Text="0" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Moderate Items" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="30-70% correct" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="DifficultItemsCount" Text="0" FontSize="32" FontWeight="Bold" Foreground="{StaticResource ErrorRed}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Difficult Items" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="?30% correct" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}" Margin="8,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="AverageDifficultyIndex" Text="0%" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Avg Difficulty" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Class average" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Item Analysis Chart and Table -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Difficulty Index Chart -->
                        <Border Grid.Column="0" Style="{StaticResource AnalyticsCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="?? Difficulty Index by Question" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <Canvas x:Name="ItemAnalysisChart" Height="300" Background="{StaticResource HeaderBackgroundBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Item Analysis Table -->
                        <Border Grid.Column="1" Style="{StaticResource AnalyticsCardStyle}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="?? Detailed Item Analysis" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <DataGrid x:Name="ItemAnalysisGrid"
                                         Background="Transparent"
                                         GridLinesVisibility="None"
                                         HeadersVisibility="Column"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         CanUserDeleteRows="False"
                                         IsReadOnly="True"
                                         SelectionMode="Single"
                                         Height="300">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Q#" Binding="{Binding QuestionNumber}" Width="40"/>
                                        <DataGridTextColumn Header="Difficulty %" Binding="{Binding DifficultyIndex, StringFormat='{}{0:F1}%'}" Width="80"/>
                                        <DataGridTextColumn Header="Classification" Binding="{Binding Classification}" Width="90"/>
                                        <DataGridTextColumn Header="Correct" Binding="{Binding CorrectCount}" Width="60"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalCount}" Width="50"/>
                                        <DataGridTemplateColumn Header="Actions" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="??" FontSize="10" Padding="4,2" Click="ViewQuestionDetails_Click" Tag="{Binding QuestionId}" ToolTip="View question details"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Item Classification Legend -->
                    <Border Style="{StaticResource AnalyticsCardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="?? Classification Guidelines" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#10B981" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Easy Items" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="?70% Correct" FontSize="12" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Text="Consider making more challenging" FontSize="10" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#3B82F6" CornerRadius="6" Padding="12" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="Moderate Items" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="30-70% Correct" FontSize="12" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Text="Good discrimination level" FontSize="10" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#EF4444" CornerRadius="6" Padding="12" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Difficult Items" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="?30% Correct" FontSize="12" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Text="Review for errors or clarity" FontSize="10" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Integrity & Incidents Panel -->
                <StackPanel x:Name="IntegrityPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Integrity Summary -->
                        <Border Grid.Row="0" Style="{StaticResource AnalyticsCardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="12" FontSize="32" FontWeight="Bold" Foreground="{StaticResource WarningYellow}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Total Incidents" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="7" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tab Switches" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="3" FontSize="32" FontWeight="Bold" Foreground="{StaticResource ErrorRed}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Focus Loss" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}" Margin="8,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="2" FontSize="32" FontWeight="Bold" Foreground="{StaticResource ErrorRed}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Multiple Logins" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Incident Timeline -->
                        <Border Grid.Row="1" Style="{StaticResource AnalyticsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="??? Integrity Incident Timeline" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Button Content="Export Report" Margin="16,0,0,0" Padding="12,6" Background="{StaticResource ErrorRed}" Foreground="White" BorderThickness="0" Style="{StaticResource RoundedButtonStyle}" Click="ExportIntegrityTimeline_Click"/>
                                </StackPanel>

                                <DataGrid x:Name="IntegrityIncidentsGrid" 
                                         Background="Transparent"
                                         GridLinesVisibility="None"
                                         HeadersVisibility="Column"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         CanUserDeleteRows="False"
                                         IsReadOnly="True"
                                         SelectionMode="Single"
                                         Height="400">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="80"/>
                                        <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="150"/>
                                        <DataGridTextColumn Header="Event Type" Binding="{Binding EventType}" Width="120"/>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                                        <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="120"/>
                                        <DataGridTemplateColumn Header="Action" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Review" FontSize="10" Padding="6,3" Click="ReviewIncident_Click" Tag="{Binding Id}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Examinee Data Panel -->
                <StackPanel x:Name="ExamineeDataPanel" Visibility="Collapsed">
                    <!-- Search Bar -->
                    <Border Style="{StaticResource AnalyticsCardStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="ExamineeSearchBox"
                                     Grid.Column="0"
                                     Padding="12,8"
                                     Background="{StaticResource HeaderBackgroundBrush}"
                                     Foreground="{StaticResource TextMuted}"
                                     BorderBrush="{StaticResource BorderBrushLight}"
                                     BorderThickness="1"
                                     FontSize="13"
                                     Text="Search examinees by name, exam, or email..."
                                     GotFocus="ExamineeSearchBox_GotFocus"
                                     LostFocus="ExamineeSearchBox_LostFocus"
                                     TextChanged="ExamineeSearchBox_TextChanged">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            
                            <Button Grid.Column="1"
                                    Content="?? Search"
                                    Margin="12,0,0,0"
                                    Padding="16,8"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SearchExaminees_Click"/>
                        </Grid>
                    </Border>

                    <!-- Examinee Data by Exam -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
                        <ItemsControl x:Name="ExamineeDataContainer">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AnalyticsCardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <!-- Exam Title Header -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                <TextBlock Text="??"
                                                          FontSize="16"
                                                          Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding ExamTitle}"
                                                          FontSize="16"
                                                          FontWeight="SemiBold"
                                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Border Background="{StaticResource AccentBlue}"
                                                       CornerRadius="12"
                                                       Padding="8,4"
                                                       Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding ExamineeCount, StringFormat='{}{0} examinees'}"
                                                              FontSize="10"
                                                              FontWeight="Medium"
                                                              Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            
                                            <!-- Examinee Data Grid -->
                                            <DataGrid ItemsSource="{Binding Examinees}"
                                                     Background="Transparent"
                                                     GridLinesVisibility="None"
                                                     HeadersVisibility="Column"
                                                     AutoGenerateColumns="False"
                                                     CanUserAddRows="False"
                                                     CanUserDeleteRows="False"
                                                     IsReadOnly="True"
                                                     SelectionMode="Single"
                                                     MaxHeight="300">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Student Name" Binding="{Binding StudentName}" Width="150"/>
                                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                                                    <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat='{}{0:F1}%'}" Width="80"/>
                                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                                    <DataGridTextColumn Header="Started" Binding="{Binding StartTime, StringFormat='{}{0:MM/dd HH:mm}'}" Width="100"/>
                                                    <DataGridTextColumn Header="Submitted" Binding="{Binding EndTime, StringFormat='{}{0:MM/dd HH:mm}'}" Width="100"/>
                                                    <DataGridTextColumn Header="Time Taken" Binding="{Binding TimeTaken}" Width="90"/>
                                                    <DataGridTemplateColumn Header="Actions" Width="120">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button Content="?? View"
                                                                           FontSize="10"
                                                                           Padding="6,3"
                                                                           Click="ViewExamineeDetails_Click"
                                                                           Tag="{Binding Id}"
                                                                           ToolTip="View detailed submission"/>
                                                                    <Button Content="?? Export"
                                                                           FontSize="10"
                                                                           Padding="6,3"
                                                                           Margin="4,0,0,0"
                                                                           Click="ExportExamineeData_Click"
                                                                           Tag="{Binding Id}"
                                                                           ToolTip="Export examinee report"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <Border x:Name="ExamineeDataEmptyState"
                           Background="{StaticResource CardBackgroundBrush}"
                           BorderBrush="{StaticResource BorderBrushLight}"
                           BorderThickness="1"
                           CornerRadius="8"
                           Padding="40"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="??"
                                      FontSize="48"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,16"/>
                            <TextBlock Text="No examinee data found"
                                      FontSize="16"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Examinee data will appear here once students start taking exams"
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>