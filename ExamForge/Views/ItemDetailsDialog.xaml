<Window x:Class="ExamForge.Views.ItemDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Question Item Analysis"
        Height="650" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        ResizeMode="CanResize">
    
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" 
                Padding="25,20">
            <StackPanel>
                <TextBlock x:Name="QuestionNumberText" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="QuestionTypeText" FontSize="13" 
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25,20">
            <StackPanel>
                <!-- Question Text -->
                <Border Background="{StaticResource CardBackgroundBrush}" 
                        BorderBrush="{StaticResource BorderBrushLight}" 
                        BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Question Text" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="QuestionText" FontSize="13" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Key Metrics -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource HeaderBackgroundBrush}" 
                            CornerRadius="6" Padding="15" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="DifficultyText" FontSize="28" FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Difficulty" FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource HeaderBackgroundBrush}" 
                            CornerRadius="6" Padding="15" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="DiscriminationText" FontSize="28" FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Discrimination" FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource HeaderBackgroundBrush}" 
                            CornerRadius="6" Padding="15" Margin="8,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="AvgTimeText" FontSize="28" FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Avg Time (sec)" FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Response Distribution -->
                <Border Background="{StaticResource CardBackgroundBrush}" 
                        BorderBrush="{StaticResource BorderBrushLight}" 
                        BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Response Distribution" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15"/>
                        <ItemsControl x:Name="ResponseDistribution">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding Option}" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        
                                        <Border Grid.Column="1" Height="20" Background="{StaticResource HeaderBackgroundBrush}" 
                                                CornerRadius="10" Margin="10,0">
                                            <Border HorizontalAlignment="Left" 
                                                    Background="{Binding BarColor}" 
                                                    Width="{Binding BarWidth}" 
                                                    CornerRadius="10"/>
                                        </Border>
                                        
                                        <TextBlock Grid.Column="2" Text="{Binding Percentage}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Width="50"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Additional Statistics -->
                <Border Background="{StaticResource CardBackgroundBrush}" 
                        BorderBrush="{StaticResource BorderBrushLight}" 
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Additional Statistics" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="PointBiserialText" FontSize="12" 
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="NoResponseText" FontSize="12" 
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="QualityText" FontSize="12" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="CorrectAnswerText" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessTextBrush}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TotalResponsesText" FontSize="12" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" 
                Padding="25,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Export PDF" Width="120" Height="35" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}" Click="ExportPdf_Click"/>
                <Button Content="Close" Width="100" Height="35" 
                        Style="{StaticResource PrimaryButtonStyle}" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
