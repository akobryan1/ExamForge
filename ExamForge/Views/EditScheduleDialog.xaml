<Window x:Class="ExamForge.Views.EditScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Exam Schedule"
        Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        ResizeMode="NoResize">
    
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" 
                Padding="25,20">
            <StackPanel>
                <TextBlock Text="Edit Exam Schedule" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="ExamTitleText" FontSize="13" 
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25,20">
            <StackPanel>
                <!-- Start Date/Time -->
                <TextBlock Text="Start Date and Time" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <DatePicker x:Name="StartDatePicker" Grid.Column="0" 
                                Height="35" FontSize="13"/>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ComboBox x:Name="StartHourCombo" Width="60" Height="35" 
                                  FontSize="13" SelectedIndex="9"/>
                        <TextBlock Text=":" FontSize="18" Margin="5,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <ComboBox x:Name="StartMinuteCombo" Width="60" Height="35" 
                                  FontSize="13" SelectedIndex="0"/>
                        <ComboBox x:Name="StartAmPmCombo" Width="60" Height="35" Margin="10,0,0,0"
                                  FontSize="13" SelectedIndex="0">
                            <ComboBoxItem Content="AM"/>
                            <ComboBoxItem Content="PM"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- End Date/Time -->
                <TextBlock Text="End Date and Time" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <DatePicker x:Name="EndDatePicker" Grid.Column="0" 
                                Height="35" FontSize="13"/>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ComboBox x:Name="EndHourCombo" Width="60" Height="35" 
                                  FontSize="13" SelectedIndex="10"/>
                        <TextBlock Text=":" FontSize="18" Margin="5,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <ComboBox x:Name="EndMinuteCombo" Width="60" Height="35" 
                                  FontSize="13" SelectedIndex="0"/>
                        <ComboBox x:Name="EndAmPmCombo" Width="60" Height="35" Margin="10,0,0,0"
                                  FontSize="13" SelectedIndex="0">
                            <ComboBoxItem Content="AM"/>
                            <ComboBoxItem Content="PM"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Duration -->
                <TextBlock Text="Exam Duration (minutes)" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                
                <TextBox x:Name="DurationTextBox" Height="35" Padding="10,8" FontSize="13"
                         Background="{StaticResource CardBackgroundBrush}"
                         BorderBrush="{StaticResource BorderBrushLight}" 
                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <!-- Warning -->
                <Border Background="{StaticResource WarningBackgroundBrush}" 
                        CornerRadius="6" Padding="15" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="??" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Changing the schedule will affect all students. Active exam sessions will not be interrupted."
                                   FontSize="12" Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" 
                Padding="25,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="100" Height="35" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="Save Changes" Width="130" Height="35" 
                        Style="{StaticResource PrimaryButtonStyle}" Click="SaveChanges_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
