<Window x:Class="ExamForge.Views.GradingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grade Essay Response"
        Height="600"
        Width="700"
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Grade Essay Response" 
                   FontSize="20" FontWeight="SemiBold" 
                   Foreground="{StaticResource TextPrimary}" 
                   Margin="0,0,0,20"/>

        <!-- Student Info -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceDark}" 
                CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Student:" FontSize="12" 
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="StudentNameText" Text="Student Name" 
                               FontSize="14" FontWeight="Medium" 
                               Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Question:" FontSize="12" 
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="QuestionNumberText" Text="Question 1" 
                               FontSize="14" FontWeight="Medium" 
                               Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Question and Answer -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Question Text -->
                <TextBlock Text="Question:" FontSize="12" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                <Border Background="{StaticResource SurfaceDark}" 
                        CornerRadius="8" Padding="12" Margin="0,0,0,16">
                    <TextBlock x:Name="QuestionTextBlock" 
                               Text="Question text will appear here" 
                               FontSize="13" 
                               Foreground="{StaticResource TextPrimary}" 
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Student Answer -->
                <TextBlock Text="Student's Answer:" FontSize="12" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                <Border Background="{StaticResource SurfaceDark}" 
                        BorderBrush="{StaticResource AccentGold}" 
                        BorderThickness="1"
                        CornerRadius="8" Padding="12">
                    <TextBlock x:Name="StudentAnswerText" 
                               Text="Student answer will appear here" 
                               FontSize="13" 
                               Foreground="{StaticResource TextPrimary}" 
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Points Input -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Points:" FontSize="14" 
                       Foreground="{StaticResource TextPrimary}" 
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            
            <TextBox x:Name="PointsTextBox" Grid.Column="1" 
                     FontSize="14" Padding="8" 
                     Background="{StaticResource SurfaceLight}" 
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource BorderColor}"
                     VerticalAlignment="Center"/>
            
            <TextBlock x:Name="MaxPointsText" Grid.Column="2" 
                       Text="/ 10 points" FontSize="14" 
                       Foreground="{StaticResource TextSecondary}" 
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>

        <!-- Feedback (Optional) -->
        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="Feedback (Optional):" FontSize="12" 
                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
            <TextBox x:Name="FeedbackTextBox" 
                     Height="80" 
                     TextWrapping="Wrap" 
                     AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource SurfaceLight}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource BorderColor}"
                     Padding="8"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" 
                    Width="100" Height="36" Margin="0,0,12,0"
                    Background="{StaticResource SurfaceLight}"
                    Foreground="{StaticResource TextPrimary}"
                    BorderBrush="{StaticResource BorderColor}"
                    Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Save Grade" 
                    Width="120" Height="36"
                    Background="{StaticResource AccentGold}"
                    Foreground="{StaticResource BackgroundDark}"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
