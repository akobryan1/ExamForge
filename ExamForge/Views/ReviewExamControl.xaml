<UserControl x:Class="ExamForge.Views.ReviewExamControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20,15">
            <TextBlock Text="Review Exam" FontSize="24" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- Exam Title -->
                <TextBlock Text="Exam Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock x:Name="TitleTextBlock" FontSize="16" Margin="0,0,0,20"/>

                <!-- Structure Preview -->
                <TextBlock Text="Exam Structure" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ItemsControl x:Name="StructureItemsControl" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,5" Padding="15" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding SectionName}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Description}" Margin="0,5,0,0" Foreground="#7F8C8D"/>
                                    <TextBlock Margin="0,5,0,0">
                                        <Run Text="Points: "/>
                                        <Run Text="{Binding Points}" FontWeight="Bold"/>
                                        <Run Text=" | Questions: "/>
                                        <Run Text="{Binding QuestionCount}" FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Content Preview -->
                <TextBlock Text="Exam Content" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ItemsControl x:Name="ContentItemsControl" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,5" Padding="15" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding QuestionText}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding QuestionType}" Margin="0,5,0,0" Foreground="#3498DB" FontStyle="Italic"/>
                                    <ItemsControl ItemsSource="{Binding Options}" Margin="10,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Margin="0,2" Foreground="#7F8C8D"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Timing Information -->
                <TextBlock Text="Timing Configuration" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Border BorderBrush="#BDC3C7" BorderThickness="1" Padding="15" CornerRadius="5" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="LiveExamTimeTextBlock" FontSize="14"/>
                        <TextBlock x:Name="DurationTextBlock" Margin="0,5,0,0" FontSize="14"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="#ECF0F1" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" 
                        Width="120" Height="40" Margin="0,0,15,0"
                        Background="White" BorderBrush="#95A5A6" BorderThickness="2"
                        FontSize="14" FontWeight="SemiBold"
                        Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#ECF0F1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="PublishButton" Content="Publish Exam" 
                        Width="150" Height="40"
                        Background="#3498DB" Foreground="White" BorderThickness="0"
                        FontSize="14" FontWeight="SemiBold"
                        Click="PublishButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2980B9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>