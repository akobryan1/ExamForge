<UserControl x:Class="ExamForge.Views.SignUpUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="400"
             Background="{StaticResource BackgroundDark}">
    
    <Border Background="{StaticResource BackgroundDark}" 
            Padding="40">
        <StackPanel VerticalAlignment="Center" MaxWidth="350">
            
            <!-- Logo/Header -->
            <TextBlock Text="ExamForge"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentTeal}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            
            <TextBlock Text="Create your account"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>
            
            <!-- Username -->
            <TextBlock Text="Username"
                       FontSize="13"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,6"/>
            
            <TextBox x:Name="UsernameTextBox"
                     Height="40"
                     Padding="12,10"
                     FontSize="14"
                     Background="{StaticResource SurfaceLight}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource BorderColor}"
                     BorderThickness="1"
                     Margin="0,0,0,16">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            
            <!-- Email -->
            <TextBlock Text="Email"
                       FontSize="13"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,6"/>
            
            <TextBox x:Name="EmailTextBox"
                     Height="40"
                     Padding="12,10"
                     FontSize="14"
                     Background="{StaticResource SurfaceLight}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource BorderColor}"
                     BorderThickness="1"
                     Margin="0,0,0,16">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            
            <!-- Password -->
            <TextBlock Text="Password"
                       FontSize="13"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,6"/>
            
            <PasswordBox x:Name="PasswordBox"
                         Height="40"
                         Padding="12,10"
                         FontSize="14"
                         Background="{StaticResource SurfaceLight}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderColor}"
                         BorderThickness="1"
                         Margin="0,0,0,16">
                <PasswordBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </PasswordBox.Resources>
            </PasswordBox>
            
            <!-- Confirm Password -->
            <TextBlock Text="Confirm Password"
                       FontSize="13"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,6"/>
            
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="40"
                         Padding="12,10"
                         FontSize="14"
                         Background="{StaticResource SurfaceLight}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderColor}"
                         BorderThickness="1"
                         Margin="0,0,0,20">
                <PasswordBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </PasswordBox.Resources>
            </PasswordBox>
            
            <!-- Error/Success Message -->
            <TextBlock x:Name="MessageText"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       Visibility="Collapsed"/>
            
            <!-- Sign Up Button -->
            <Button x:Name="SignUpButton"
                    Content="Create Account"
                    Height="44"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Margin="0,0,0,15"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SignUp_Click"/>
            
            <!-- Login Link -->
            <TextBlock HorizontalAlignment="Center">
                <Run Text="Already have an account?" 
                     Foreground="{StaticResource TextSecondary}"
                     FontSize="13"/>
                <Hyperlink x:Name="LoginLink"
                           Click="Login_Click"
                           Foreground="{StaticResource AccentTeal}"
                           TextDecorations="None">
                    <Run Text="Sign In" FontSize="13" FontWeight="SemiBold"/>
                </Hyperlink>
            </TextBlock>
            
            <!-- Loading Indicator -->
            <ProgressBar x:Name="LoadingBar"
                         Height="4"
                         Margin="0,20,0,0"
                         IsIndeterminate="True"
                         Visibility="Collapsed"
                         Foreground="{StaticResource AccentTeal}"/>
            
        </StackPanel>
    </Border>
</UserControl>
