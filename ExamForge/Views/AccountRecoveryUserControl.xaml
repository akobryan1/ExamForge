<UserControl x:Class="ExamForge.Views.AccountRecoveryUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="400"
             Background="{StaticResource BackgroundDark}">
    
    <Border Background="{StaticResource BackgroundDark}" 
            Padding="40">
        <StackPanel VerticalAlignment="Center" MaxWidth="350">
            
            <!-- Logo/Header -->
            <TextBlock Text="ExamForge"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentTeal}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            
            <TextBlock Text="Reset your password"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            
            <TextBlock Text="Enter your username and email address to receive password reset instructions."
                       FontSize="12"
                       Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,30"/>
            
            <!-- Username -->
            <TextBlock Text="Username"
                       FontSize="13"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,6"/>
            
            <TextBox x:Name="UsernameTextBox"
                     Height="40"
                     Padding="12,10"
                     FontSize="14"
                     Background="{StaticResource SurfaceLight}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource BorderColor}"
                     BorderThickness="1"
                     Margin="0,0,0,16">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            
            <!-- Email -->
            <TextBlock Text="Email"
                       FontSize="13"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,6"/>
            
            <TextBox x:Name="EmailTextBox"
                     Height="40"
                     Padding="12,10"
                     FontSize="14"
                     Background="{StaticResource SurfaceLight}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource BorderColor}"
                     BorderThickness="1"
                     Margin="0,0,0,20">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            
            <!-- Error/Success Message -->
            <TextBlock x:Name="MessageText"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       Visibility="Collapsed"/>
            
            <!-- Reset Password Button -->
            <Button x:Name="ResetButton"
                    Content="Send Reset Link"
                    Height="44"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Margin="0,0,0,15"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ResetPassword_Click"/>
            
            <!-- Back to Login Link -->
            <TextBlock HorizontalAlignment="Center">
                <Hyperlink x:Name="BackToLoginLink"
                           Click="BackToLogin_Click"
                           Foreground="{StaticResource AccentTeal}"
                           TextDecorations="None">
                    <Run Text="? Back to Sign In" FontSize="13"/>
                </Hyperlink>
            </TextBlock>
            
            <!-- Loading Indicator -->
            <ProgressBar x:Name="LoadingBar"
                         Height="4"
                         Margin="0,20,0,0"
                         IsIndeterminate="True"
                         Visibility="Collapsed"
                         Foreground="{StaticResource AccentTeal}"/>
            
        </StackPanel>
    </Border>
</UserControl>
