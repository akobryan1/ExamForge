<Window x:Class="ExamForge.Views.LoadingDialog"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Publishing Exam"
Height="200"
Width="400"
WindowStartupLocation="CenterScreen"
WindowStyle="None"
ResizeMode="NoResize"
Background="Transparent"
AllowsTransparency="True"
Topmost="True">
    <Border Background="{StaticResource SurfaceDark}"
            CornerRadius="10"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Publishing Exam..."
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"
                       HorizontalAlignment="Center"/>

            <ProgressBar Grid.Row="2"
                         IsIndeterminate="True"
                         Height="6"
                         Background="{StaticResource SurfaceLight}"
                         Foreground="#6AA6FF"/>

            <TextBlock x:Name="StatusText"
                       Grid.Row="4"
                       Text="Deploying to Firebase Hosting..."
                       FontSize="14"
                       Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>