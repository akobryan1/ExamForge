<Window x:Class="ExamForge.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExamForge - Sign In"
        Height="600" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    
    <Grid>
        <!-- Background decoration -->
        <Border Background="{StaticResource CardBackgroundBrush}" 
                CornerRadius="12" Margin="40"
                Effect="{StaticResource CardShadow}">
            
            <StackPanel VerticalAlignment="Center" Margin="50">
                
                <!-- Logo/Branding -->
                <TextBlock Text="ExamForge" 
                           FontSize="38" 
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,8"/>
                
                <TextBlock Text="Instructor Portal" 
                           FontSize="16"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,50"/>

                <!-- Welcome message -->
                <TextBlock Text="Welcome Back" 
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,8"/>
                
                <TextBlock Text="Sign in to manage your exams" 
                           FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,40"/>

                <!-- Google Sign-In Button -->
                <Button x:Name="GoogleSignInButton" 
                        Height="56" 
                        Padding="20"
                        Background="White" 
                        BorderBrush="{StaticResource PrimaryBrush}" 
                        BorderThickness="2"
                        Click="GoogleSignIn_Click"
                        Cursor="Hand"
                        Margin="0,0,0,20">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SoftAccentBackgroundBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    
                    <StackPanel Orientation="Horizontal">
                        <!-- Google Icon (using text as placeholder) -->
                        <TextBlock Text="G" 
                                   FontSize="24" 
                                   FontWeight="Bold"
                                   Foreground="#4285F4"
                                   Width="32" 
                                   Height="32"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        
                        <TextBlock Text="Sign in with Google" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <!-- Status Text -->
                <TextBlock x:Name="StatusText" 
                           Text="" 
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center" 
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,20"
                           Visibility="Collapsed"/>

                <!-- Loading Indicator -->
                <ProgressBar x:Name="LoadingBar" 
                             IsIndeterminate="True" 
                             Height="3" 
                             Foreground="{StaticResource PrimaryBrush}"
                             Background="{StaticResource SoftAccentBackgroundBrush}"
                             BorderThickness="0"
                             Visibility="Collapsed"/>

                <!-- Footer info -->
                <TextBlock Text="By signing in, you agree to our Terms of Service" 
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" 
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,40,0,0"/>
            </StackPanel>
        </Border>

        <!-- Version info -->
        <TextBlock Text="Version 1.0.0" 
                   FontSize="10"
                   Foreground="{StaticResource TextMutedBrush}"
                   HorizontalAlignment="Right" 
                   VerticalAlignment="Bottom"
                   Margin="20"/>
    </Grid>
</Window>
