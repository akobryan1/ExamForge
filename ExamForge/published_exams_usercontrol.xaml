<UserControl x:Class="ExamForge.published_exams_usercontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ExamForge"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1000"
             Margin="0"
             Background="{StaticResource BackgroundDark}">

    <UserControl.Resources>
        <!-- Tab Button Style -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Chip Style -->
        <Style x:Key="FilterChipStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                CornerRadius="999"
                                Padding="{TemplateBinding Padding}"
                                Background="{StaticResource SurfaceLight}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3d3850"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentGoldGradient}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                                <Setter Property="Foreground" Value="#1c192a"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Exam Card Style with Left Gold Gradient Border -->
        <Style x:Key="ExamCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Background="{StaticResource SurfaceLight}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4a7ab5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Premium Background -->
    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" Padding="24,24,24,16">
            <StackPanel>
                <TextBlock Text="Published Exams and Student Analytics"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Manage exam delivery, maintain your exam bank, and analyze results"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tab Navigation -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceDark}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1"
                Margin="24,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ScheduledTab"
                             Content="📋 Scheduled Exams"
                             Style="{StaticResource TabButtonStyle}"
                             IsChecked="True"
                             Checked="Tab_Changed"/>
                <RadioButton x:Name="ExamBankTab"
                             Content="📚 Exam Bank"
                             Style="{StaticResource TabButtonStyle}"
                             Checked="Tab_Changed"/>
                <RadioButton x:Name="EssayCheckerTab"
                             Content="📝 Essay Checker"
                             Style="{StaticResource TabButtonStyle}"
                             Checked="Tab_Changed"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,16,24,24">
            <Grid>
                <!-- Scheduled Exams Panel -->
                <StackPanel x:Name="ScheduledPanel" Visibility="Visible">
                    <!-- Filters and Search -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Filter Chips -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <RadioButton x:Name="FilterAll"
                                         Content="All"
                                         Style="{StaticResource FilterChipStyle}"
                                         IsChecked="True"
                                         Checked="Filter_Changed"
                                         GroupName="StatusFilter"/>
                            <RadioButton x:Name="FilterUpcoming"
                                         Content="Upcoming"
                                         Style="{StaticResource FilterChipStyle}"
                                         Checked="Filter_Changed"
                                         GroupName="StatusFilter"
                                         Margin="8,0,0,0"/>
                            <RadioButton x:Name="FilterActive"
                                         Content="Active"
                                         Style="{StaticResource FilterChipStyle}"
                                         Checked="Filter_Changed"
                                         GroupName="StatusFilter"
                                         Margin="8,0,0,0"/>
                            <RadioButton x:Name="FilterCompleted"
                                         Content="Completed"
                                         Style="{StaticResource FilterChipStyle}"
                                         Checked="Filter_Changed"
                                         GroupName="StatusFilter"
                                         Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Search Box -->
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Width="250"
                                 Padding="10,8,10,8"
                                 Background="{StaticResource SurfaceLight}"
                                 Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource BorderColor}"
                                 BorderThickness="1"
                                 FontSize="13"
                                 TextChanged="SearchBox_TextChanged">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>

                    <!-- Exam Cards List -->
                    <ItemsControl x:Name="ExamCardsContainer">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Card + Hover overlay -->
                                <Grid Margin="0,0,0,12">
                                    <!-- Actual card: receives mouse events -->
                                    <Border x:Name="CardBorder"
                                            Style="{StaticResource ExamCardStyle}"
                                            Background="{StaticResource SurfaceDark}">
                                        <Border.Triggers>
                                            <!-- MouseEnter -> fade in the gold gradient and increase thickness -->
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1"
                                                                         Duration="0:0:0.22"
                                                                         AccelerationRatio="0.2"/>
                                                        <ThicknessAnimation Storyboard.TargetName="HoverOverlay"
                                                                            Storyboard.TargetProperty="BorderThickness"
                                                                            To="2,2,2,2"
                                                                            Duration="0:0:0.22"
                                                                            AccelerationRatio="0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>

                                            <!-- MouseLeave -> fade out the gold gradient and remove thickness -->
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.25"
                                                                         DecelerationRatio="0.2"/>
                                                        <ThicknessAnimation Storyboard.TargetName="HoverOverlay"
                                                                            Storyboard.TargetProperty="BorderThickness"
                                                                            To="0,0,0,0"
                                                                            Duration="0:0:0.25"
                                                                            DecelerationRatio="0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>

                                        <!-- Card content -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Title -->
                                            <TextBlock Grid.Row="0"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       Text="{Binding Title}"/>

                                            <!-- Schedule Info -->
                                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,0">
                                                    <TextBlock Text="📅 "
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding ScheduleText}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="⏱️ "
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding DurationText}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Status and Metadata -->
                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Background="{Binding StatusColor}"
                                                        CornerRadius="4"
                                                        Padding="8,4">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Foreground="#1c192a"/>
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding CreatedByText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMuted}"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"/>
                                            </Grid>

                                            <!-- Actions -->
                                            <StackPanel Grid.Row="3"
                                                        Orientation="Horizontal"
                                                        Margin="0,12,0,0">
                                                <Button Content="Open Preview"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Click="OpenPreview_Click"
                                                        Tag="{Binding Id}"/>
                                                <Button Content="Edit Schedule"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Click="EditSchedule_Click"
                                                        Tag="{Binding Id}"
                                                        Margin="8,0,0,0"/>
                                                <Button Content="Copy URL"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Click="CopyUrl_Click"
                                                        Tag="{Binding ExamUrl}"
                                                        Margin="8,0,0,0"/>
                                                <Button Content="Unpublish"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Click="Unpublish_Click"
                                                        Tag="{Binding Id}"
                                                        Margin="8,0,0,0"
                                                        Foreground="{StaticResource ErrorRed}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Hover overlay (rendered above card) -->
                                    <Border x:Name="HoverOverlay"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource PremiumGoldHoverBrush}"
                                            BorderThickness="0,0,0,0"
                                            CornerRadius="12"
                                            Opacity="0"
                                            IsHitTestVisible="False"
                                            Panel.ZIndex="2"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <Border x:Name="EmptyState"
                            Background="{StaticResource SurfaceDark}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="40"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,60,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📋"
                                       FontSize="48"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="No published exams yet"
                                       FontSize="18"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Create and publish your first exam to see it here"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Live Exams Panel -->
                <StackPanel x:Name="LivePanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Live Roster Monitor -->
                        <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" CornerRadius="12" Padding="20" Margin="0,0,12,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="🔴 Live Exam Monitor" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Border Background="#10B981" CornerRadius="4" Padding="8,4" Margin="12,0,0,0">
                                        <TextBlock x:Name="ActiveSessionsText" Text="0 Active Sessions" FontSize="11" FontWeight="Medium" Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <!-- Quick Stats -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="LiveOnlineValue" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Online" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock x:Name="LiveDisconnectedValue" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorRed}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Disconnected" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock x:Name="LiveProgressValue" Text="0%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Avg Progress" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <TextBlock x:Name="LiveFlagsValue" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningYellow}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Flags" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Student Roster -->
                                <DataGrid x:Name="LiveRosterGrid" 
                                         Background="Transparent"
                                         GridLinesVisibility="None"
                                         HeadersVisibility="Column"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         CanUserDeleteRows="False"
                                         IsReadOnly="True"
                                         SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding ConnectionStatus}" Width="100"/>
                                        <DataGridTextColumn Header="Progress" Binding="{Binding ProgressPercent}" Width="80"/>
                                        <DataGridTextColumn Header="Time Left" Binding="{Binding TimeRemaining}" Width="90"/>
                                        <DataGridTextColumn Header="Flags" Binding="{Binding FlagCount}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Incident Feed -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceDark}" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="⚠️ Incident Feed" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                                
                                <ScrollViewer Height="400" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="IncidentFeedList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceLight}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding StudentName}" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="8,0,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding EventType}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                
                                <!-- Quick Actions -->
                                <StackPanel Margin="0,16,0,0">
                                    <Button Content="Broadcast Message" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,8" Click="BroadcastMessage_Click"/>
                                    <Button Content="Pause All Exams" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,8" Click="PauseAllExams_Click"/>
                                    <Button Content="Export Live Report" Style="{StaticResource ActionButtonStyle}" Click="ExportLiveReport_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Exam Bank Panel -->
                <StackPanel x:Name="ExamBankPanel" Visibility="Collapsed">
                    <Border Background="{StaticResource SurfaceDark}" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="📚 Exam Bank" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <Button Content="+ Create Template" Style="{StaticResource ActionButtonStyle}" Margin="16,0,0,0" Click="CreateTemplate_Click"/>
                            </StackPanel>

                            <!-- Search and Filters -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="BankSearchBox" Grid.Column="0" Text="Search exam bank..." Padding="10,8" Background="{StaticResource SurfaceLight}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" FontSize="13" TextChanged="BankSearch_Changed" GotFocus="BankSearchBox_GotFocus" LostFocus="BankSearchBox_LostFocus"/>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                    <ComboBox x:Name="SubjectFilter" Width="150" Padding="8" Background="{StaticResource SurfaceLight}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" SelectionChanged="SubjectFilter_Changed"/>
                                </StackPanel>
                            </Grid>

                            <!-- Exam Bank Grid -->
                            <DataGrid x:Name="ExamBankGrid" 
                                     Background="Transparent"
                                     GridLinesVisibility="None"
                                     HeadersVisibility="Column"
                                     AutoGenerateColumns="False"
                                     CanUserAddRows="False"
                                     CanUserDeleteRows="False"
                                     IsReadOnly="True"
                                     SelectionMode="Single"
                                     Height="400">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="120"/>
                                    <DataGridTextColumn Header="Questions" Binding="{Binding QuestionCount}" Width="80"/>
                                    <DataGridTextColumn Header="Usage" Binding="{Binding TimesUsed}" Width="60"/>
                                    <DataGridTextColumn Header="Last Used" Binding="{Binding LastUsed, StringFormat='{}{0:MM/dd}'}" Width="80"/>
                                    <DataGridTemplateColumn Header="Actions" Width="360">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Reuse Template" FontSize="10" Padding="6,3" Click="ReuseExam_Click" Tag="{Binding Id}" ToolTip="Reuse exam structure and content as a template"/>
                                                    <Button Content="Republish" FontSize="10" Padding="6,3" Margin="4,0,0,0" Click="RepublishExam_Click" Tag="{Binding Id}" ToolTip="Republish this exam"/>
                                                    <Button Content="Delete" FontSize="10" Padding="6,3" Margin="4,0,0,0" Click="DeleteExam_Click" Tag="{Binding Id}" ToolTip="Delete this exam"/>
                                                    <Button Content="📋 Copy Link" FontSize="10" Padding="6,3" Margin="4,0,0,0" Click="CopyExamLink_Click" Tag="{Binding Id}" ToolTip="Copy exam URL to clipboard"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="EssayCheckerPanel" Visibility="Collapsed">
                    <local:essay_checker_usercontrol/>
                </StackPanel>

                <!-- Closed and Grading Panel -->
                <StackPanel x:Name="ClosedPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Grading Queue -->
                        <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" CornerRadius="12" Padding="20" Margin="0,0,12,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="📊 Grading Queue" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource WarningYellow}" CornerRadius="4" Padding="8,4" Margin="12,0,0,0">
                                        <TextBlock x:Name="PendingReviewBadge" Text="0 Pending Review" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BackgroundDark}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Quick Stats -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="AutoGradedValue" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Auto-Graded" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock x:Name="ManualReviewValue" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningYellow}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Manual Review" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock x:Name="PassRateValue" Text="0%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Pass Rate" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Submissions requiring manual grading -->
                                <DataGrid x:Name="GradingQueueGrid" 
                                         Background="Transparent"
                                         GridLinesVisibility="None"
                                         HeadersVisibility="Column"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         CanUserDeleteRows="False"
                                         IsReadOnly="True"
                                         SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="*"/>
                                        <DataGridTextColumn Header="Exam" Binding="{Binding ExamTitle}" Width="*"/>
                                        <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedAt, StringFormat='{}{0:MM/dd HH:mm}'}" Width="120"/>
                                        <DataGridTextColumn Header="Auto Score" Binding="{Binding AutoScore}" Width="80"/>
                                        <DataGridTextColumn Header="Essays" Binding="{Binding EssayCount}" Width="60"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                        <DataGridTemplateColumn Header="Action" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Review" Style="{StaticResource ActionButtonStyle}" Click="ReviewSubmission_Click" Tag="{Binding Id}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Graded Essays Archive -->
                                <TextBlock Text="Graded Essays" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,20,0,8"/>
                                <DataGrid x:Name="GradedEssayGrid"
                                         Background="Transparent"
                                         GridLinesVisibility="None"
                                         HeadersVisibility="Column"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         CanUserDeleteRows="False"
                                         IsReadOnly="True"
                                         SelectionMode="Single"
                                         Height="180">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="*"/>
                                        <DataGridTextColumn Header="Exam" Binding="{Binding ExamTitle}" Width="*"/>
                                        <DataGridTextColumn Header="Question #" Binding="{Binding QuestionNumber}" Width="90"/>
                                        <DataGridTextColumn Header="Score" Binding="{Binding AutoScore}" Width="80"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Quick Actions -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceDark}" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="⚡ Quick Actions" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                                
                                <Button Content="Bulk Finalize Grades" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,8" Click="BulkFinalize_Click"/>
                                <Button Content="Release Results" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,8" Click="ReleaseResults_Click"/>
                                <Button Content="Reopen for Make-up" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,8" Click="ReopenMakeup_Click"/>
                                <Button Content="Export Gradebook" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,8" Click="ExportGradebook_Click"/>
                                
                                <Border Background="{StaticResource SurfaceLight}" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Grade Distribution" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="A: " FontSize="12" Foreground="{StaticResource TextSecondary}" Width="20"/>
                                                <Border x:Name="GradeABar" Background="{StaticResource AccentGold}" Height="4" Width="0" CornerRadius="2" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="GradeAValue" Text=" 0%" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="B: " FontSize="12" Foreground="{StaticResource TextSecondary}" Width="20"/>
                                                <Border x:Name="GradeBBar" Background="{StaticResource AccentBlue}" Height="4" Width="0" CornerRadius="2" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="GradeBValue" Text=" 0%" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="C: " FontSize="12" Foreground="{StaticResource TextSecondary}" Width="20"/>
                                                <Border x:Name="GradeCBar" Background="{StaticResource WarningYellow}" Height="4" Width="0" CornerRadius="2" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="GradeCValue" Text=" 0%" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="F: " FontSize="12" Foreground="{StaticResource TextSecondary}" Width="20"/>
                                                <Border x:Name="GradeFBar" Background="{StaticResource ErrorRed}" Height="4" Width="0" CornerRadius="2" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="GradeFValue" Text=" 0%" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Reports Panel -->
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>