<UserControl x:Class="ExamForge.TrueFalseEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <StackPanel>
        <TextBlock Text="Select Correct Answer"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}"
                   Margin="0,0,0,12"/>

        <!-- True Option -->
        <Border Background="{StaticResource SurfaceLight}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12"
                Cursor="Hand"
                MouseLeftButtonDown="TrueOption_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0"
                         Width="32" Height="32"
                         Fill="#10b981"
                         Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1"
                           Text="TRUE"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <RadioButton x:Name="TrueRadio"
                             Grid.Column="2"
                             GroupName="TrueFalse"
                             VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- False Option -->
        <Border Background="{StaticResource SurfaceLight}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12"
                Cursor="Hand"
                MouseLeftButtonDown="FalseOption_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0"
                         Width="32" Height="32"
                         Fill="#ef4444"
                         Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1"
                           Text="FALSE"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <RadioButton x:Name="FalseRadio"
                             Grid.Column="2"
                             GroupName="TrueFalse"
                             VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Custom Points -->
        <Border Background="{StaticResource SurfaceLight}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Custom Points (optional)"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="CustomPointsTextBox"
                         Grid.Column="1"
                         Background="{StaticResource SurfaceDark}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderColor}"
                         BorderThickness="1"
                         Padding="8,6"
                         TextAlignment="Center"
                         TextChanged="CustomPoints_TextChanged">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>