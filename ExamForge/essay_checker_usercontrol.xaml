<UserControl x:Class="ExamForge.essay_checker_usercontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="960"
             Margin="0"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,20">

            <!-- Page Header -->
            <TextBlock Text="Essay Checker" 
                       Style="{StaticResource PageTitleStyle}" 
                       Margin="0,0,0,4"/>
            <TextBlock Text="Evaluate student essays against a rubric using AI-powered grading"
                       Style="{StaticResource SmallTextStyle}" 
                       Margin="0,0,0,20"/>

            <!-- API Configuration Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="API Configuration" 
                               Style="{StaticResource SectionTitleStyle}" 
                               Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="API Key" FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="ApiKeyBox" Height="36" Padding="8,6"
                                         Background="{StaticResource HeaderBackgroundBrush}"
                                         BorderBrush="{StaticResource BorderBrushLight}"
                                         FontSize="13"
                                         PasswordChanged="ApiKeyBox_PasswordChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Model" FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ModelComboBox" Height="36" Padding="8,6"
                                      Style="{StaticResource CleanComboBoxStyle}"
                                      SelectionChanged="ModelComboBox_SelectionChanged">
                                <ComboBoxItem Content="gpt-4o-mini" IsSelected="True"/>
                                <ComboBoxItem Content="gpt-4o"/>
                                <ComboBoxItem Content="gpt-3.5-turbo"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                            <TextBlock x:Name="ApiStatusText" Text="● Not configured" 
                                       FontSize="12" Foreground="{StaticResource ErrorTextBrush}" 
                                       VerticalAlignment="Center" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Rubric Management Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Grading Rubric" 
                                       Style="{StaticResource SectionTitleStyle}" 
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="RubricTitleText" 
                                       Text="Standard Essay Evaluation Rubric" 
                                       FontSize="16" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="RubricPointsText" 
                                       Text="Total: 100 points" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Upload Rubric" 
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="UploadRubric_Click" Margin="0,0,8,0"/>
                            <Button Content="Export Rubric" 
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ExportRubric_Click" Margin="0,0,8,0"/>
                            <Button Content="Reset to Default" 
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ResetRubric_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Rubric Criteria List -->
                    <ItemsControl x:Name="RubricCriteriaList" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource HeaderBackgroundBrush}" 
                                        CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                        BorderBrush="{StaticResource BorderBrushLight}" 
                                        BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="14" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border Grid.Column="1" 
                                                    Background="{StaticResource PrimarySoftBrush}" 
                                                    CornerRadius="4" Padding="8,2">
                                                <TextBlock Text="{Binding MaxPoints, StringFormat='{}{0} pts'}" 
                                                           FontSize="12" FontWeight="Medium"
                                                           Foreground="{StaticResource PrimaryBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Description}" FontSize="12" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Essay Input Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Essay Evaluation" 
                               Style="{StaticResource SectionTitleStyle}" 
                               Margin="0,0,0,12"/>

                    <!-- Question/Prompt -->
                    <TextBlock Text="Essay Prompt / Question" FontSize="12" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="EssayPromptBox" Height="60" 
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource HeaderBackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrushLight}"
                             Padding="8" FontSize="13" Margin="0,0,0,12"/>

                    <!-- Student Essay -->
                    <TextBlock Text="Student Essay" FontSize="12" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="EssayTextBox" Height="180" 
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource HeaderBackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrushLight}"
                             Padding="8" FontSize="13" Margin="0,0,0,16"/>

                    <!-- Evaluate Button -->
                    <Button x:Name="EvaluateButton" Content="🔍  Evaluate Essay" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" Padding="24,10"
                            Click="EvaluateButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Results Card (initially hidden) -->
            <Border x:Name="ResultsCard" Style="{StaticResource CardStyle}" 
                    Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel>
                    <!-- Results Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Evaluation Results" 
                                   Style="{StaticResource SectionTitleStyle}"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Background="{StaticResource PrimarySoftBrush}" 
                                    CornerRadius="6" Padding="16,8" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TotalScoreText" Text="0" 
                                               Style="{StaticResource KpiValueStyle}"/>
                                    <TextBlock x:Name="MaxScoreText" Text="/100" 
                                               FontSize="16" 
                                               Foreground="{StaticResource TextSecondaryBrush}" 
                                               VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="GradeBadge" 
                                    Background="{StaticResource PrimaryBrush}" 
                                    CornerRadius="6" Padding="16,8">
                                <TextBlock x:Name="LetterGradeText" Text="A" 
                                           FontSize="24" FontWeight="Bold" 
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Criterion Scores -->
                    <TextBlock Text="Criterion Breakdown" FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               Margin="0,0,0,8"/>
                    <ItemsControl x:Name="CriterionScoresList" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource HeaderBackgroundBrush}" 
                                        CornerRadius="6" Padding="12" Margin="0,0,0,6"
                                        BorderBrush="{StaticResource BorderBrushLight}" 
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CriterionName}" 
                                                   FontSize="13" FontWeight="Medium" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding ScoreDisplay}" 
                                                   FontSize="13" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource PrimaryBrush}" 
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" 
                                                Background="{StaticResource PrimarySoftBrush}" 
                                                CornerRadius="4" Padding="6,2" 
                                                HorizontalAlignment="Left" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Level}" FontSize="11" 
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding Feedback}" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                                   TextWrapping="Wrap" VerticalAlignment="Center" 
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Overall Feedback -->
                    <TextBlock Text="Overall Feedback" FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               Margin="0,0,0,8"/>
                    <Border Background="{StaticResource HeaderBackgroundBrush}" 
                            CornerRadius="6" Padding="12" Margin="0,0,0,16"
                            BorderBrush="{StaticResource BorderBrushLight}" 
                            BorderThickness="1">
                        <TextBlock x:Name="OverallFeedbackText" Text="" 
                                   FontSize="13" TextWrapping="Wrap" 
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>

                    <!-- Strengths & Areas for Improvement -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Strengths -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="✅ Strengths" FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource SuccessTextBrush}" 
                                       Margin="0,0,0,8"/>
                            <ItemsControl x:Name="StrengthsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Areas for Improvement -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="📝 Areas for Improvement" FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource WarningTextBrush}" 
                                       Margin="0,0,0,8"/>
                            <ItemsControl x:Name="ImprovementsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Loading Overlay (initially hidden) -->
            <Border x:Name="LoadingOverlay" Visibility="Collapsed"
                    Background="{StaticResource CardBackgroundBrush}" 
                    CornerRadius="8" Padding="24"
                    BorderBrush="{StaticResource BorderBrushLight}" 
                    BorderThickness="1" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Evaluating essay..." FontSize="14" 
                               FontWeight="Medium" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Width="200"
                                 Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="The AI is analyzing the essay against your rubric" 
                               FontSize="12" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
