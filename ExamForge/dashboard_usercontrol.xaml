<UserControl x:Class="ExamForge.dashboard_usercontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource AppBackgroundBrush}"
             FontFamily="Segoe UI"
             Loaded="Dashboard_usercontrol_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30" MaxWidth="1200">
            
            <!-- Page Title -->
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,30"/>

            <!-- KPI Row -->
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="UpcomingCard_Click">
                    <StackPanel>
                        <TextBlock Text="Upcoming Exams" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="UpcomingCountText" Style="{StaticResource KpiValueStyle}" Text="0"/>
                        <TextBlock x:Name="UpcomingSubtitle" Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0" Cursor="Hand" MouseLeftButtonUp="FlagsCard_Click">
                    <StackPanel>
                        <TextBlock Text="Flags / Incidents" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="FlagsCountText" Style="{StaticResource KpiValueStyle}" Text="0"/>
                        <TextBlock x:Name="FlagsSubtitle" Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Content Grid -->
            <Grid Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Hero Panel (Live Monitor or Schedule) -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,15,0" MinHeight="250">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,15">
                            <TextBlock x:Name="HeroPanelTitle" Text="Today's Schedule / Live Monitor" 
                                       Style="{StaticResource SectionTitleStyle}" DockPanel.Dock="Left"/>
                        </DockPanel>

                        <!-- Live Stats -->
                        <StackPanel x:Name="LiveStatsPanel" Orientation="Horizontal" Margin="0,0,0,15">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Started" Style="{StaticResource SmallTextStyle}"/>
                                <TextBlock x:Name="StartedCountText" Style="{StaticResource KpiValueStyle}" Text="0" FontSize="20"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Submitted" Style="{StaticResource SmallTextStyle}"/>
                                <TextBlock x:Name="SubmittedCountText" Style="{StaticResource KpiValueStyle}" Text="0" FontSize="20"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Avg Progress" Style="{StaticResource SmallTextStyle}"/>
                                <TextBlock x:Name="AvgProgressText" Style="{StaticResource KpiValueStyle}" Text="0%" FontSize="20"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Last Activity" Style="{StaticResource SmallTextStyle}"/>
                                <TextBlock x:Name="LastActivityText" Style="{StaticResource KpiValueStyle}" Text="--" FontSize="20"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Schedule List -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="180">
                            <ItemsControl x:Name="TodayScheduleList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource HeaderBackgroundBrush}" 
                                                CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" 
                                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                                <TextBlock Text="{Binding Schedule}" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Meta}" 
                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="Edit" Width="60" Height="28" Click="EditExam_Click" Tag="{Binding ExamId}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"/>
                                                    <Button Content="Duplicate" Width="80" Height="28" Click="DuplicateExam_Click" Tag="{Binding ExamId}" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"/>
                                                    <Button Content="View Monitor" Width="100" Height="28" Click="ViewMonitor_Click" Tag="{Binding ExamId}" Style="{StaticResource SecondaryButtonStyle}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="TodayEmptyState" Text="No scheduled exams today." 
                                   Style="{StaticResource SmallTextStyle}" FontStyle="Italic" Visibility="Collapsed"/>
                        
                        <TextBlock x:Name="LiveEmpty" Text="? No live sessions." 
                                   Style="{StaticResource SmallTextStyle}" FontStyle="Italic" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Right Column -->
                <StackPanel Grid.Column="1">
                    <!-- Quick Actions Panel -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Quick Actions" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15"/>
                            
                            <StackPanel>
                                <Button Content="Create New Exam" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        Margin="0,0,0,10"
                                        Click="CreateExam_Click"/>
                                <Button Content="View Analytics" 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Margin="0,0,0,10"
                                        Click="ViewAnalytics_Click"/>
                                <Button Content="Manage Exam Bank" 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Margin="0,0,0,10"
                                        Click="ManageExamBank_Click"/>
                                <Button Content="Settings" 
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OpenSettings_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
