{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information"
    }
  },
  "AllowedHosts": "*",
  "Google": {
    "ClientId": "${GOOGLE_CLIENTID}",
    "ClientSecret": "${GOOGLE_CLIENTSECRET}",
    "RedirectUri": "${GOOGLE_REDIRECTURI}"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}"
  }
}
